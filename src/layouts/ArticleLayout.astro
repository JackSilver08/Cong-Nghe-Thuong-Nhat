---
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Comments from '../components/Comments.astro';
import type { Post } from '../lib/posts';
import { postSlug, formatDate } from '../lib/posts';
import { categoryLabel } from '../lib/categories';

export interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { data } = post;
const slug = postSlug(post);
const leftRecommendations = related.slice(0, 2);
const rightRecommendations = related.slice(2, 4);
const footerRecommendations = related.slice(4, 7);
const canonical = new URL(`/article/${slug}`, Astro.site).toString();
const ogImage = data.image
  ? new URL(data.image, Astro.site).toString()
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: data.title,
  description: data.excerpt,
  image: ogImage ? [ogImage] : undefined,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: [{ '@type': 'Person', name: data.author }],
  publisher: {
    '@type': 'Organization',
    name: 'Công Nghệ Thường Nhật',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/assets/cong-nghe-thuong-nhat-icon.png', Astro.site).toString(),
    },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: categoryLabel(data.category),
  keywords: data.tags.join(', '),
};
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  image={data.image}
  type="article"
  jsonLd={jsonLd}
>
  <article class="article">
    <div class="container article-shell">
      <aside class="article-rail article-rail-left" aria-label="Gợi ý đọc thêm">
        <div class="rail-inner">
          <p class="rail-heading">Đọc thêm</p>
          {leftRecommendations.map((item) => (
            <a class="rail-card" href={`/article/${postSlug(item)}`}>
              {item.data.image && (
                <img src={item.data.image} alt="" loading="lazy" />
              )}
              <span class="rail-category">{categoryLabel(item.data.category)}</span>
              <strong>{item.data.title}</strong>
              <span class="rail-time">{item.data.readingTime || 1} phút đọc</span>
            </a>
          ))}
        </div>
      </aside>

      <div class="article-container">
      <!-- breadcrumb -->
      <nav class="breadcrumb" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a>
        <span aria-hidden="true">/</span>
        <a href={`/category/${data.category}`}>{categoryLabel(data.category)}</a>
      </nav>

      <header class="article-header">
        <a href={`/category/${data.category}`} class="chip chip-solid">{categoryLabel(data.category)}</a>
        <h1 class="article-title">{data.title}</h1>
        <p class="article-excerpt">{data.excerpt}</p>

        <div class="article-meta">
          <div class="byline">
            <span class="byline-author">{data.author}</span>
            <span class="byline-dates">
              <time datetime={data.publishedAt.toISOString()}>Đăng {formatDate(data.publishedAt)}</time>
              {data.updatedAt && data.updatedAt.valueOf() !== data.publishedAt.valueOf() && (
                <> · <time datetime={data.updatedAt.toISOString()}>Cập nhật {formatDate(data.updatedAt)}</time></>
              )}
              {data.readingTime && <> · {data.readingTime} phút đọc</>}
            </span>
          </div>
          <div class="article-actions">
            <button type="button" class="btn action-copy" data-url={canonical}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07L11 5"></path><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07L13 19"></path></svg>
              <span class="action-label">Sao chép liên kết</span>
            </button>
            <button type="button" class="btn action-save" data-slug={slug} data-title={data.title}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
              <span class="action-label">Lưu bài</span>
            </button>
          </div>
        </div>
      </header>

      {data.image && (
        <figure class="article-hero">
          <img src={data.image} alt={data.imageAlt || data.title} fetchpriority="high" />
          {data.imageAlt && <figcaption>{data.imageAlt}</figcaption>}
        </figure>
      )}

      <div class="article-content">
        <slot />
      </div>

      {data.tags.length > 0 && (
        <div class="article-tags" aria-label="Thẻ">
          {data.tags.map((tag) => (
            <a href={`/search?q=${encodeURIComponent(tag)}`} class="tag">#{tag}</a>
          ))}
        </div>
      )}
      </div>

      <aside class="article-rail article-rail-right" aria-label="Bài viết được đề xuất">
        <div class="rail-inner">
          <p class="rail-heading">Dành cho bạn</p>
          {rightRecommendations.map((item) => (
            <a class="rail-card" href={`/article/${postSlug(item)}`}>
              {item.data.image && (
                <img src={item.data.image} alt="" loading="lazy" />
              )}
              <span class="rail-category">{categoryLabel(item.data.category)}</span>
              <strong>{item.data.title}</strong>
              <span class="rail-time">{item.data.readingTime || 1} phút đọc</span>
            </a>
          ))}
        </div>
      </aside>
    </div>

    <Comments slug={slug} />

    {footerRecommendations.length > 0 && (
      <section class="related section" aria-label="Bài viết liên quan">
        <div class="container">
          <div class="section-head">
            <h2 class="section-title">Bài viết liên quan</h2>
          </div>
          <div class="grid grid-3">
            {footerRecommendations.map((p) => <ArticleCard post={p} headingLevel={3} />)}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .article-shell {
    display: grid;
    grid-template-columns: minmax(190px, 230px) minmax(0, 760px) minmax(190px, 230px);
    justify-content: center;
    align-items: start;
    gap: clamp(24px, 3vw, 48px);
  }
  .article-container {
    width: 100%;
    min-width: 0;
  }
  .article-rail {
    padding-top: 112px;
    min-width: 0;
  }
  .rail-inner {
    position: sticky;
    top: 92px;
  }
  .rail-heading {
    margin: 0 0 14px;
    padding-left: 10px;
    border-left: 3px solid var(--nh-purple);
    color: var(--text);
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-weight: 800;
  }
  .rail-card {
    display: block;
    padding: 10px;
    margin-bottom: 14px;
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .rail-card:hover {
    transform: translateY(-3px);
    border-color: rgba(70, 72, 212, 0.3);
    box-shadow: 0 12px 28px rgba(70, 72, 212, 0.12);
  }
  .rail-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 9px;
  }
  .rail-category,
  .rail-time {
    display: block;
    color: var(--text-muted);
    font-size: 0.72rem;
  }
  .rail-category {
    margin-bottom: 4px;
    color: var(--nh-purple);
    font-weight: 800;
    text-transform: uppercase;
  }
  .rail-card strong {
    display: -webkit-box;
    overflow: hidden;
    margin-bottom: 7px;
    color: var(--text);
    font-family: var(--font-head);
    font-size: 0.9rem;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  @media (max-width: 1279px) {
    .article-shell {
      display: block;
    }
    .article-container {
      max-width: 760px;
      margin-inline: auto;
    }
    .article-rail {
      display: none;
    }
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    padding-top: 24px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .breadcrumb a:hover {
    color: var(--nh-purple);
  }
  .article-header {
    padding-block: 18px 8px;
  }
  .article-title {
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 14px 0 12px;
  }
  .article-excerpt {
    font-size: 1.12rem;
    color: var(--text-soft);
    line-height: 1.6;
    margin: 0 0 20px;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-block: 16px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .byline-author {
    font-family: var(--font-head);
    font-weight: 700;
    display: block;
  }
  .byline-dates {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .article-actions {
    display: flex;
    gap: 10px;
  }
  .article-actions .btn {
    padding: 8px 14px;
    font-size: 0.85rem;
  }
  .action-save.is-saved {
    background: var(--nh-grad);
    color: #fff;
    border-color: transparent;
  }

  .article-hero {
    margin: 26px 0;
  }
  .article-hero img {
    width: 100%;
    border-radius: 16px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .article-hero figcaption {
    margin-top: 8px;
    font-size: 0.82rem;
    color: var(--text-muted);
    text-align: center;
  }

  /* ------ readable content typography ------ */
  .article-content {
    font-size: 1.09rem;
    line-height: 1.8;
    color: #1e293b;
  }
  .article-content :global(p) {
    margin: 0 0 1.3em;
  }
  .article-content :global(h2) {
    font-size: 1.5rem;
    margin: 1.8em 0 0.6em;
  }
  .article-content :global(h3) {
    font-size: 1.25rem;
    margin: 1.5em 0 0.5em;
  }
  .article-content :global(a) {
    color: var(--nh-purple);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-content :global(ul),
  .article-content :global(ol) {
    padding-left: 1.4em;
    margin: 0 0 1.3em;
  }
  .article-content :global(li) {
    margin-bottom: 0.5em;
  }
  .article-content :global(blockquote) {
    margin: 1.5em 0;
    padding: 4px 20px;
    border-left: 4px solid var(--nh-purple);
    background: rgba(139, 92, 246, 0.06);
    color: var(--text-soft);
    font-style: italic;
    border-radius: 0 8px 8px 0;
  }
  .article-content :global(img) {
    border-radius: 12px;
    margin: 1.5em 0;
  }
  .article-content :global(pre) {
    padding: 16px;
    border-radius: 12px;
    overflow-x: auto;
    margin: 1.5em 0;
    font-size: 0.9rem;
  }
  .article-content :global(code) {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
  }

  /* ------ bảng ------ */
  /* Khối cuộn riêng cho bảng: bảng nhiều cột phải tự trượt ngang, không được
     đẩy tràn cả trang trên điện thoại. */
  .article-content :global(.table-scroll) {
    overflow-x: auto;
    margin: 1.6em 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    -webkit-overflow-scrolling: touch;
  }
  .article-content :global(.table-scroll table) {
    margin: 0;
    border: 0;
    border-radius: 0;
  }
  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.6em 0;
    font-size: 0.98rem;
    line-height: 1.6;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .article-content :global(thead th) {
    background: var(--surface);
    font-family: var(--font-head);
    font-weight: 700;
    color: #0f172a;
    white-space: nowrap;
  }
  .article-content :global(th),
  .article-content :global(td) {
    padding: 11px 16px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .article-content :global(th:not(:last-child)),
  .article-content :global(td:not(:last-child)) {
    border-right: 1px solid var(--border);
  }
  /* Căn lề cột do người viết chọn trong editor: marked xuất ra thuộc tính
     align=..., mà thuộc tính này thua mọi rule CSS nên phải khai báo lại. */
  .article-content :global([align='center']) {
    text-align: center;
  }
  .article-content :global([align='right']) {
    text-align: right;
  }
  .article-content :global([align='left']) {
    text-align: left;
  }
  /* Kẻ sọc xen kẽ cho dễ dò mắt theo hàng ngang. */
  .article-content :global(tbody tr:nth-child(even)) {
    background: rgba(139, 92, 246, 0.04);
  }
  .article-content :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  /* Bài Markdown trong src/content đi qua pipeline riêng của Astro nên không có
     lớp .table-scroll bọc ngoài — cho chính thẻ table tự cuộn để khỏi tràn trang. */
  @media (max-width: 640px) {
    .article-content :global(table:not(.table-scroll table)) {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }
  }

  /* ------ các thành phần khác editor tạo ra được ------ */
  .article-content :global(hr) {
    height: 1px;
    border: 0;
    background: var(--border);
    margin: 2.2em 0;
  }
  .article-content :global(del),
  .article-content :global(s) {
    color: var(--text-muted);
  }
  /* Danh sách việc cần làm: bỏ chấm đầu dòng, chừa chỗ cho ô tick. */
  .article-content :global(li:has(> input[type='checkbox'])) {
    list-style: none;
    margin-left: -1.4em;
  }
  .article-content :global(li > input[type='checkbox']) {
    margin-right: 0.55em;
    accent-color: var(--nh-purple);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 12px;
  }
  .tag {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-soft);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 5px 12px;
    border-radius: 999px;
  }
  .tag:hover {
    color: var(--nh-purple);
    border-color: var(--nh-purple);
  }

  .related {
    background: var(--bg);
    border-top: 1px solid var(--border);
    margin-top: 36px;
  }
</style>

<script>
  // Copy link
  const copyBtn = document.querySelector<HTMLButtonElement>('.action-copy');
  copyBtn?.addEventListener('click', async () => {
    const url = copyBtn.dataset.url ?? window.location.href;
    const label = copyBtn.querySelector('.action-label');
    try {
      await navigator.clipboard.writeText(url);
      if (label) label.textContent = 'Đã sao chép!';
      setTimeout(() => label && (label.textContent = 'Sao chép liên kết'), 1800);
    } catch {
      if (label) label.textContent = 'Không thể sao chép';
    }
  });

  // Lưu bài vào Supabase (gắn tài khoản, đồng bộ đa thiết bị)
  const saveBtn = document.querySelector<HTMLButtonElement>('.action-save');
  if (saveBtn) {
    const slug = saveBtn.dataset.slug!;
    const title = saveBtn.dataset.title ?? '';
    const label = saveBtn.querySelector('.action-label');

    import('../lib/supabaseBrowser').then(async ({ supabaseBrowser, getCurrentUser }) => {
      const me = await getCurrentUser();
      let saved = false;

      const paint = () => {
        saveBtn.classList.toggle('is-saved', saved);
        if (label) label.textContent = saved ? 'Đã lưu' : 'Lưu bài';
      };

      if (me) {
        const { data } = await supabaseBrowser
          .from('saved_posts')
          .select('post_slug')
          .eq('user_id', me.id)
          .eq('post_slug', slug)
          .maybeSingle();
        saved = Boolean(data);
        paint();
      }

      saveBtn.addEventListener('click', async () => {
        if (!me) {
          window.location.href = '/login?next=' + encodeURIComponent(window.location.pathname);
          return;
        }
        saveBtn.disabled = true;
        if (saved) {
          await supabaseBrowser.from('saved_posts').delete().eq('user_id', me.id).eq('post_slug', slug);
          saved = false;
        } else {
          await supabaseBrowser
            .from('saved_posts')
            .insert({ user_id: me.id, post_slug: slug, post_title: title });
          saved = true;
        }
        saveBtn.disabled = false;
        paint();
      });
    });
  }
</script>
