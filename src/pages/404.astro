---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, postSlug } from '../lib/posts';

const latest = (await getPublishedPosts()).slice(0, 4);
---

<BaseLayout title="Không tìm thấy trang" description="Trang bạn tìm không tồn tại.">
  <div class="container notfound">
    <p class="nf-code">404</p>
    <h1>Không tìm thấy bài viết</h1>
    <p class="nf-desc">
      Đường dẫn có thể đã thay đổi hoặc bài viết không tồn tại. Bạn có thể quay về
      trang chủ hoặc đọc một trong những tin mới nhất bên dưới.
    </p>
    <a href="/" class="btn btn-primary">Về trang chủ</a>

    <ul class="nf-list">
      {latest.map((p) => (
        <li><a href={`/article/${postSlug(p)}`}>{p.data.title}</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding: var(--space-8) var(--space-5) var(--space-9);
    text-align: center;
    max-width: 640px;
  }
  .nf-code {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(4rem, 14vw, 7rem);
    line-height: 1;
    margin: 0;
    color: var(--primary);
  }
  .notfound h1 {
    font-size: var(--fs-section);
    margin: var(--space-2) 0 var(--space-3);
  }
  .nf-desc {
    color: var(--text-soft);
    margin-bottom: var(--space-5);
  }
  .nf-list {
    list-style: none;
    padding: 0;
    margin: var(--space-7) auto 0;
    display: grid;
    gap: var(--space-2);
    text-align: left;
    max-width: 460px;
  }
  .nf-list a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.94rem;
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .nf-list a:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
</style>
