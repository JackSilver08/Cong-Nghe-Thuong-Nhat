---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, postSlug } from '../lib/posts';

const latest = (await getPublishedPosts()).slice(0, 4);
---

<BaseLayout title="Không tìm thấy trang" description="Trang bạn tìm không tồn tại.">
  <div class="container notfound">
    <p class="nf-status">Mất tín hiệu · Mã 404</p>
    <p class="nf-code">404</p>
    <h1>Không tìm thấy bài viết</h1>
    <p class="nf-desc">
      Đường dẫn có thể đã thay đổi hoặc bài viết không tồn tại. Bạn có thể quay về
      trang chủ hoặc đọc một trong những tin mới nhất bên dưới.
    </p>
    <a href="/" class="btn btn-primary">Về trang chủ</a>

    <p class="nf-list-title">Tín hiệu gần đây</p>
    <ul class="nf-list">
      {latest.map((p) => (
        <li><a href={`/article/${postSlug(p)}`}>{p.data.title}</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding: var(--space-8) var(--space-5) var(--space-9);
    text-align: center;
    max-width: 640px;
  }
  .nf-status {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 4px 10px;
    background: var(--color-signal-alert);
    color: #fff;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 700;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }
  .nf-code {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(4.5rem, 16vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    margin: var(--space-4) 0 0;
    color: var(--color-brand-primary);
    font-variant-numeric: tabular-nums;
  }
  .notfound h1 {
    font-size: var(--fs-display-sm);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: var(--space-3) 0 var(--space-3);
  }
  .nf-desc {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
    line-height: 1.65;
  }
  .nf-list-title {
    margin: var(--space-8) 0 var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-text-primary);
    color: var(--color-brand-primary);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 700;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    text-align: left;
  }
  .nf-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    text-align: left;
  }
  .nf-list a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.96rem;
    line-height: 1.4;
    transition: color var(--dur-fast) ease;
  }
  .nf-list li:last-child a {
    border-bottom: 1px solid var(--color-border);
  }
  .nf-list a::before {
    content: '↳';
    margin-right: var(--space-3);
    color: var(--color-border-strong);
  }
  .nf-list a:hover {
    color: var(--color-brand-primary);
  }
  .nf-list a:hover::before {
    color: var(--color-brand-primary);
  }

  @media (max-width: 640px) {
    .notfound {
      padding: var(--space-6) 0 var(--space-7);
    }
    .nf-code {
      margin-top: var(--space-3);
    }
    .nf-list-title {
      margin-top: var(--space-6);
    }
  }
</style>
