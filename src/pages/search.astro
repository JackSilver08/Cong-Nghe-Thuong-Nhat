---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SearchBox from '../components/SearchBox.astro';
import { getPublishedPosts, postSlug } from '../lib/posts';
import { categoryLabelFrom, getCategories } from '../lib/categories';

const posts = await getPublishedPosts();
const categories = await getCategories();

// Precompute a searchable text blob per post (title, excerpt, category, tags, author).
const items = posts.map((p) => ({
  slug: postSlug(p),
  category: p.data.category,
  haystack: [
    p.data.title,
    p.data.excerpt,
    categoryLabelFrom(categories, p.data.category),
    p.data.category,
    p.data.author,
    ...p.data.tags,
  ].join(' '),
}));
---

<BaseLayout
  title="Tìm kiếm bài viết"
  description="Tìm kiếm và lọc tin công nghệ, AI, khởi nghiệp, an ninh mạng trên Công Nghệ Thường Nhật."
>
  <div class="container search-page">
    <header class="search-header">
      <p class="search-kicker">
        Tra cứu kho tín hiệu
        <em aria-hidden="true"></em>
        <span>{items.length} bài đang lưu trữ</span>
      </p>
      <h1>Tìm kiếm bài viết</h1>
      <div class="search-input-wrap">
        <SearchBox variant="page" />
      </div>
    </header>

    <p class="search-status" role="status" aria-live="polite" data-total={items.length}></p>

    <div class="grid grid-3 search-results">
      {posts.map((p, i) => (
        <div
          class="search-item"
          data-search={items[i].haystack}
          data-category={items[i].category}
        >
          <ArticleCard post={p} headingLevel={2} />
        </div>
      ))}
    </div>

    <div class="search-empty state-block" hidden>
      <strong>Không tìm thấy bài viết phù hợp</strong>
      <p>Thử từ khoá ngắn hơn, bỏ dấu hoặc chọn một chuyên mục khác ở phía trên.</p>
      <a href="/search" class="btn">Xoá bộ lọc</a>
    </div>
  </div>
</BaseLayout>

<style>
  .search-page {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  .search-header {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-text-primary);
  }
  .search-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    color: var(--color-brand-primary);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 700;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }
  .search-kicker em {
    flex: 0 1 160px;
    height: 1px;
    background: var(--color-border);
    font-style: normal;
  }
  .search-kicker span {
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .search-header h1 {
    font-size: var(--fs-display-sm);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-4);
  }
  .search-input-wrap {
    max-width: 560px;
  }
  .search-status {
    margin: var(--space-5) 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }
  .search-item {
    display: block;
    min-width: 0;
  }
  .search-empty[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .search-page {
      padding-top: var(--space-5);
    }
    /* Đường kẻ nối và số lượng bài đẩy dòng nhãn xuống hai hàng ở màn hẹp —
       giữ lại nhãn chính, bỏ phần trang trí. */
    .search-kicker em {
      display: none;
    }
    .search-status {
      margin-top: var(--space-4);
    }
  }
</style>

<script>
  // Diacritic-insensitive normalization for Vietnamese search.
  const COMBINING = /[̀-ͯ]/g;
  const normalize = (s: string) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(COMBINING, '')
      .replace(/đ/g, 'd')
      .trim();

  const items = Array.from(document.querySelectorAll<HTMLElement>('.search-item'));
  const status = document.querySelector<HTMLElement>('.search-status');
  const empty = document.querySelector<HTMLElement>('.search-empty');
  const input = document.querySelector<HTMLInputElement>('.search-page input[name="q"]');
  const total = Number(status?.dataset.total ?? items.length);

  // Precompute normalized haystacks once.
  const data = items.map((el) => ({
    el,
    text: normalize(el.dataset.search ?? ''),
    category: el.dataset.category ?? '',
  }));

  let activeCategory = '';

  function apply(query: string) {
    const q = normalize(query);
    const terms = q.split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const d of data) {
      const matchText = terms.every((t) => d.text.includes(t));
      const matchCat = !activeCategory || d.category === activeCategory;
      const visible = matchText && matchCat;
      d.el.hidden = !visible;
      if (visible) shown++;
    }
    if (empty) empty.hidden = shown !== 0;
    if (status) {
      if (!query && !activeCategory) {
        status.textContent = `Đang hiển thị tất cả ${total} bài viết.`;
      } else {
        status.textContent = `Tìm thấy ${shown} bài viết${query ? ` cho “${query}”` : ''}.`;
      }
    }
  }

  // Read initial query from URL (?q= and ?category=).
  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q') ?? '';
  activeCategory = params.get('category') ?? '';
  if (input) input.value = initialQuery;

  input?.addEventListener('input', () => apply(input.value));

  // Intercept the form submit so it filters in place instead of reloading.
  input?.closest('form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    apply(input?.value ?? '');
  });

  apply(initialQuery);
</script>
