---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCategories } from '../../lib/categories';
import { getPostsByCategory } from '../../lib/posts';

const categories = await getCategories();
const category = categories.find((item) => item.slug === Astro.params.slug);
if (!category) {
  return Astro.redirect('/404', 302);
}
const posts = await getPostsByCategory(category.slug);
---

<BaseLayout
  title={`${category.label} — Tin công nghệ`}
  description={category.description}
>
  <div class="container cat-page">
    <nav class="breadcrumb" aria-label="Đường dẫn">
      <a href="/">Trang chủ</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{category.label}</span>
    </nav>

    <header class="cat-header">
      <p class="cat-kicker">Chuyên mục</p>
      <h1>{category.label}</h1>
      <p class="cat-desc">{category.description}</p>
    </header>

    {posts.length > 0 ? (
      <div class="grid grid-3 cat-grid">
        {posts.map((p) => <ArticleCard post={p} headingLevel={2} />)}
      </div>
    ) : (
      <div class="state-block">
        <strong>Chưa có bài viết trong chuyên mục này</strong>
        <p>Chuyên mục đang được cập nhật. Bạn có thể xem những tin mới nhất ở trang chủ.</p>
        <a href="/" class="btn btn-primary">Về trang chủ</a>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .cat-page {
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  /* WCAG 2.2 AA (2.5.8): vùng chạm tối thiểu 24×24px cho liên kết phụ. */
  .breadcrumb a,
  .breadcrumb span {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    min-width: 24px;
    justify-content: center;
  }
  .breadcrumb a:hover {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cat-header {
    margin-bottom: var(--space-5);
  }
  .cat-kicker {
    color: var(--primary);
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8rem;
    margin: 0 0 var(--space-1);
  }
  .cat-header h1 {
    font-size: var(--fs-h1);
    margin: 0 0 var(--space-2);
  }
  .cat-desc {
    color: var(--text-soft);
    max-width: 60ch;
    margin: 0;
  }
</style>
