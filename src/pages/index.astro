---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroNews from '../components/HeroNews.astro';
import BreakingTicker from '../components/BreakingTicker.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PopularList from '../components/PopularList.astro';
import CategoryNav from '../components/CategoryNav.astro';
import AiDailyBrief from '../components/AiDailyBrief.astro';
import TechRadar from '../components/TechRadar.astro';
import {
  getPublishedPosts,
  getTrendingPosts,
  getPopularPosts,
  getPostsByCategory,
  getPostsForSection,
  postSlug,
  type Post,
} from '../lib/posts';

const allPosts = await getPublishedPosts();
const fallbackFeatured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const featured = getPostsForSection(
  allPosts,
  'home-hero',
  1,
  fallbackFeatured ? [fallbackFeatured] : [],
)[0];

const featuredSlug = featured ? postSlug(featured) : '';
const postsWithoutFeatured = allPosts.filter((p) => postSlug(p) !== featuredSlug);

/*
 * Chống trùng bài ở lớp trình bày.
 *
 * Trang chủ dựng theo thứ tự: hero → cột cạnh hero → Cập nhật mới nhất →
 * Xu hướng công nghệ → Bản tin AI. Với mỗi khối, chỉ DANH SÁCH DỰ PHÒNG do
 * chính trang này ghép mới được sắp xếp lại theo hai quy tắc:
 *
 *   1. bài đã hiện ở khu vực phía trên bị đẩy xuống cuối;
 *   2. bài "để dành" cho khối Xu hướng (biên tập gán thẳng section, hoặc gắn
 *      cờ trending) cũng bị đẩy xuống, để nó xuất hiện đúng một chỗ.
 *
 * Đây là sắp xếp lại chứ không phải lọc bỏ: nếu hết bài mới, các bài bị hạ ưu
 * tiên vẫn được dùng nên không khối nào bị thiếu. Bài do biên tập gán thẳng
 * vào section luôn được getPostsForSection giữ nguyên — thuật toán chọn bài,
 * truy vấn và nguồn dữ liệu đều không đổi.
 */
const reservedForTrends = new Set(
  allPosts
    .filter((p) => p.data.trending || p.data.sections.includes('tech-trends'))
    .map(postSlug),
);
const shown = new Set<string>(featuredSlug ? [featuredSlug] : []);
const markShown = (posts: Post[]) => posts.forEach((p) => shown.add(postSlug(p)));

/** Sắp lại danh sách dự phòng: bài đã dùng và bài để dành lùi về cuối. */
function rank(posts: Post[], reserved?: Set<string>): Post[] {
  const score = (post: Post) => {
    const slug = postSlug(post);
    if (shown.has(slug)) return 2;
    return reserved?.has(slug) ? 1 : 0;
  };
  // Array#sort ổn định nên thứ tự gốc trong từng nhóm được giữ nguyên.
  return [...posts].sort((a, b) => score(a) - score(b));
}

const heroSide = getPostsForSection(
  postsWithoutFeatured,
  'home-side',
  3,
  rank(postsWithoutFeatured, reservedForTrends),
);
markShown(heroSide);

const breaking = getPostsForSection(allPosts, 'breaking-news', 5, allPosts);

const latest = getPostsForSection(allPosts, 'latest-news', 6, rank(allPosts, reservedForTrends));
markShown(latest);

const fallbackTrending = await getTrendingPosts(12);
const trending = getPostsForSection(allPosts, 'tech-trends', 4, rank(fallbackTrending));
markShown(trending);

const fallbackAiBrief = await getPostsByCategory('ai');
const aiBrief = getPostsForSection(allPosts, 'ai-daily-brief', 3, rank(fallbackAiBrief));

// "Đọc nhiều" là bảng xếp hạng nên vẫn giữ nguyên thứ tự gốc, kể cả khi trùng
// với feed — lọc bớt sẽ làm sai ý nghĩa của danh sách.
const fallbackPopular = await getPopularPosts(5);
const popular = getPostsForSection(allPosts, 'popular-sidebar', 5, fallbackPopular);

// Mốc quy đổi "cường độ tín hiệu": điểm phổ biến cao nhất trong số bài đang có.
// Chỉ dùng để hiển thị, không tác động tới thứ tự hay cách chọn bài.
const maxScore = allPosts.reduce((max, p) => Math.max(max, p.data.popularScore), 0);
---

<BaseLayout title="Tin tức công nghệ và AI" appendSiteName={false}>
  <div class="container">
    {featured && (
      <HeroNews post={featured} side={heroSide} maxScore={maxScore} totalPosts={allPosts.length} />
    )}
    <div class="ticker-wrap">
      <BreakingTicker posts={breaking} />
    </div>
    <div class="cat-row">
      <CategoryNav />
    </div>
  </div>

  <div class="container">
    <TechRadar posts={allPosts} />
  </div>

  <div class="container layout-main">
    <div class="main-col">
      <section class="section" aria-labelledby="latest-title">
        <div class="zone-head">
          <span class="zone-code">
            Khu vực 04
            <em aria-hidden="true"></em>
            Dòng quan sát
          </span>
          <h2 class="zone-title" id="latest-title">Cập nhật mới nhất</h2>
          <a href="/search" class="zone-link">Toàn bộ bài viết</a>
        </div>

        <div class="latest-grid">
          {latest.map((p, i) => (
            <div class={`latest-cell latest-cell-${i + 1}`}>
              <ArticleCard
                post={p}
                headingLevel={3}
                variant={i === 0 ? 'feature' : i === 3 ? 'text' : i === 5 ? 'compact' : 'standard'}
                maxScore={maxScore}
              />
            </div>
          ))}
        </div>
      </section>
    </div>

    <aside class="sidebar" aria-label="Nội dung phụ">
      <PopularList posts={popular} title="Đọc nhiều" />
    </aside>
  </div>

  <div class="container">
    <AiDailyBrief posts={aiBrief} />

    {trending.length > 0 && (
      <section class="section trend-section" aria-labelledby="trend-title">
        <div class="zone-head">
          <span class="zone-code">
            Khu vực 05
            <em aria-hidden="true"></em>
            Đang tăng tốc
          </span>
          <h2 class="zone-title" id="trend-title">Xu hướng công nghệ</h2>
          <p class="zone-note">Các chủ đề đang được nhắc tới nhiều nhất trong vài ngày qua.</p>
        </div>

        <ol class="trend-rail" tabindex="0" aria-label="Danh sách xu hướng, cuộn ngang được">
          {trending.map((p, i) => (
            <li class="trend-item">
              <span class="trend-index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <ArticleCard post={p} headingLevel={3} variant={i === 0 ? 'feature' : 'standard'} maxScore={maxScore} />
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .ticker-wrap {
    margin-top: var(--space-6);
  }
  .cat-row {
    margin-top: var(--space-5);
  }
  /* Từ 1081px header đã có hàng chuyên mục nên dải chip trên trang là thừa. */
  @media (min-width: 1081px) {
    .cat-row {
      display: none;
    }
  }
  .main-col {
    min-width: 0;
  }

  /* ============================================================
     LƯỚI LỆCH — CẬP NHẬT MỚI NHẤT
     Sáu ô với ba nhịp khác nhau. Chỉ đặt bằng grid-column, không dùng position
     tuyệt đối, nên thứ tự DOM luôn đúng bằng thứ tự đọc và ở màn hẹp chỉ cần
     bỏ template là về một cột sạch.
     ============================================================ */
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: var(--space-5);
    row-gap: var(--space-6);
  }
  .latest-cell {
    min-width: 0;
  }
  .latest-cell-1 {
    grid-column: span 4;
  }
  .latest-cell-2 {
    grid-column: span 2;
  }
  .latest-cell-3 {
    grid-column: span 3;
  }
  .latest-cell-4 {
    grid-column: span 3;
  }
  .latest-cell-5 {
    grid-column: span 4;
  }
  .latest-cell-6 {
    grid-column: span 2;
  }
  /* Khoảng trắng có chủ đích: ô chỉ chữ được đẩy xuống một nhịp so với ô ảnh
     bên cạnh, tạo bậc thang thay vì hàng ngang phẳng. */
  .latest-cell-4 {
    padding-top: var(--space-6);
  }

  .sidebar {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    position: sticky;
    top: calc(var(--header-h) + var(--space-5));
  }

  /* ============================================================
     XU HƯỚNG — RAIL CUỘN NGANG
     Vùng cuộn nằm gọn trong section. Trên mobile chuyển sang snap từng ô.
     ============================================================ */
  .trend-section {
    padding-bottom: var(--space-8);
  }
  .trend-rail {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin: 0;
    padding: 0;
  }
  .trend-item {
    position: relative;
    min-width: 0;
    padding-top: var(--space-5);
  }
  .trend-index {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--color-text-muted);
    font-weight: 700;
  }
  @media (max-width: 1120px) {
    .latest-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .latest-cell-1 {
      grid-column: span 4;
    }
    .latest-cell-2,
    .latest-cell-3,
    .latest-cell-4,
    .latest-cell-5,
    .latest-cell-6 {
      grid-column: span 2;
    }
    .latest-cell-4 {
      padding-top: 0;
    }
    /* Rail thành vùng vuốt ngang có snap. */
    .trend-rail {
      grid-auto-flow: column;
      grid-auto-columns: minmax(260px, 78%);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      padding-bottom: var(--space-3);
    }
    .trend-item {
      scroll-snap-align: start;
    }
  }

  @media (max-width: 960px) {
    .sidebar {
      position: static;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  @media (max-width: 720px) {
    .latest-grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-5);
    }
    .latest-cell-1,
    .latest-cell-2,
    .latest-cell-3,
    .latest-cell-4,
    .latest-cell-5,
    .latest-cell-6 {
      grid-column: 1;
    }
    .trend-rail {
      grid-auto-columns: minmax(240px, 86%);
    }
    .trend-section {
      padding-bottom: var(--space-7);
    }
  }
</style>
