<script>
  import { supabaseBrowser, supabaseConfigured } from '../lib/supabaseBrowser';

  const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.parentElement!.querySelector<HTMLElement>('[data-status]')!;

    function show(message: string, ok: boolean) {
      status.textContent = message;
      status.classList.toggle('is-ok', ok);
      status.classList.toggle('is-error', !ok);
      status.hidden = false;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = input.value.trim();
      if (!EMAIL_RE.test(email)) {
        show('Địa chỉ thư điện tử chưa hợp lệ, bạn kiểm tra lại nhé.', false);
        input.focus();
        return;
      }

      if (!supabaseConfigured) {
        show('Chức năng đăng ký chưa được cấu hình.', false);
        return;
      }

      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      status.hidden = true;

      const { data, error } = await supabaseBrowser.functions.invoke('subscribe-newsletter', {
        body: { email },
      });

      button.disabled = false;
      form.removeAttribute('aria-busy');

      if (error) {
        show('Đăng ký chưa được, bạn thử lại sau nhé.', false);
        return;
      }

      show(
        data?.alreadySubscribed
          ? 'Email này đã đăng ký bản tin rồi — cảm ơn bạn!'
          : data?.emailSent
            ? 'Đã đăng ký! 5 bài mới nhất đang được gửi tới hộp thư của bạn. 📬'
            : 'Đã đăng ký! Email đầu tiên có thể đến chậm một chút.',
        true,
      );
      form.reset();
    });
  });
</script>
