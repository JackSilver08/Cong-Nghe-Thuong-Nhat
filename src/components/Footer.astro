---
import { getCategories } from '../lib/categories';
import { observationDate } from '../lib/signal';

const categories = await getCategories();
const today = new Date(
  new Date().toLocaleString('en-US', { timeZone: 'Asia/Ho_Chi_Minh' }),
);
---

<footer class="site-footer obs-grid obs-grid-dark">
  <div class="container footer-status">
    <p class="footer-status-live">
      <span class="signal-dot" aria-hidden="true"></span>
      Hệ thống quan sát <b>đang hoạt động</b>
    </p>
    <p class="footer-status-date">
      Cập nhật <time datetime={today.toISOString().slice(0, 10)}>{observationDate(today)}</time>
    </p>
  </div>

  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Công Nghệ Thường Nhật - Trang chủ">
        <img
          src="/assets/cong-nghe-thuong-nhat-logo-footer-v2.webp"
          alt="Công Nghệ Thường Nhật"
          width="1254"
          height="1254"
        />
      </a>
      <p class="footer-wordmark">Công Nghệ<br />Thường Nhật</p>
      <p class="footer-tagline">
        Không chỉ đọc tin. Quan sát công nghệ chuyển động.
      </p>
    </div>

    <nav class="footer-col footer-zones" aria-label="Chuyên mục">
      <h2>Vùng quan sát</h2>
      <ul>
        {categories.map((cat) => (
          <li><a href={`/category/${cat.slug}`}>{cat.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col footer-info" aria-label="Thông tin và chính sách">
      <h2>Thông tin</h2>
      <ul>
        <li><a href="/gioi-thieu">Giới thiệu</a></li>
        <li><a href="/lien-he">Liên hệ</a></li>
        <li><a href="/chinh-sach-bien-tap">Chính sách biên tập</a></li>
        <li><a href="/chinh-sach-quyen-rieng-tu">Quyền riêng tư</a></li>
        <li><a href="/dieu-khoan-su-dung">Điều khoản sử dụng</a></li>
      </ul>
    </nav>

    <div class="footer-col footer-newsletter">
      <h2>Kênh nhận tín hiệu</h2>
      <p>Nhận ngay 5 bài mới nhất và bản tin công nghệ vào sáng Thứ Hai hàng tuần.</p>
      <form data-newsletter novalidate>
        <label class="visually-hidden" for="footer-email">Thư điện tử của bạn</label>
        <input
          id="footer-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="Thư điện tử của bạn"
          required
        />
        <button type="submit" data-submit>Gửi</button>
      </form>
      <p class="newsletter-status" data-status hidden role="status" aria-live="polite"></p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-sign">Kết thúc phiên quan sát — hẹn gặp lại vào bản tin sau</p>
      <p class="footer-copy">Mọi bản quyền thuộc về Công Nghệ Thường Nhật</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface-dark);
    color: var(--color-text-on-dark);
    margin-top: var(--space-8);
  }

  /* Dải trạng thái mở đầu phần chân trang — khép lại vòng với dải ở đầu site. */
  .footer-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 34px;
    border-bottom: 1px solid var(--color-border-on-dark);
  }
  .footer-status p {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-text-on-dark-muted);
    white-space: nowrap;
  }
  .footer-status-live b {
    color: var(--color-accent-bright);
    font-weight: 700;
  }
  .footer-status-date time {
    color: var(--color-text-on-dark);
    font-variant-numeric: tabular-nums;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(180px, 0.7fr) minmax(200px, 0.7fr) minmax(300px, 1.1fr);
    gap: clamp(28px, 4vw, 64px);
    padding-block: var(--space-7);
    align-items: start;
  }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    margin-bottom: var(--space-3);
  }
  .footer-logo img {
    width: 72px;
    height: 72px;
    object-fit: contain;
    object-position: left center;
  }
  /* Chữ thương hiệu cỡ lớn: điểm kết thị giác của trang, không cần thêm hiệu ứng. */
  .footer-wordmark {
    margin: 0 0 var(--space-3);
    color: #fff;
    font-family: var(--font-head);
    font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3.1rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .footer-tagline {
    max-width: 34ch;
    color: var(--color-text-on-dark-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .footer-col h2 {
    color: var(--color-accent-bright);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-on-dark);
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .footer-col li {
    min-width: 0;
  }
  .footer-col a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    /* nhãn ngắn ("AI") vẫn phải đạt vùng chạm tối thiểu 24px bề ngang */
    min-width: 24px;
    color: var(--color-text-on-dark);
    font-size: 0.92rem;
  }
  .footer-zones a::before {
    content: '+';
    margin-right: var(--space-2);
    color: var(--color-border-on-dark);
  }
  .footer-zones a:hover::before {
    color: var(--color-accent-bright);
  }
  .footer-newsletter p {
    color: #a8b2c3;
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
  }
  .footer-newsletter form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .footer-newsletter input {
    min-width: 0;
    flex: 1 1 180px;
    min-height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-control);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    padding: 0 var(--space-3);
    font: inherit;
    font-size: 0.95rem;
  }
  .footer-newsletter input::placeholder {
    color: #94a0b4;
  }
  .footer-newsletter input:focus-visible {
    outline: 2px solid #8f91f0;
    outline-offset: 1px;
  }
  .footer-newsletter button {
    flex: 0 0 auto;
    min-height: 44px;
    min-width: 72px;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--primary);
    color: var(--primary-contrast);
    font-family: var(--font-head);
    font-weight: 600;
    padding: 0 var(--space-4);
    cursor: pointer;
    transition: background var(--dur-fast) ease;
  }
  .footer-newsletter button:hover:not(:disabled) {
    background: #5a5ce0;
  }
  .footer-newsletter button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .newsletter-status {
    margin: var(--space-2) 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .newsletter-status.is-ok {
    color: #7ef0d0;
  }
  .newsletter-status.is-error {
    color: #fca5a5;
  }
  .footer-col a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-bottom {
    border-top: 1px solid var(--color-border-on-dark);
    padding-block: var(--space-4);
  }
  .footer-bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }
  .footer-bottom p {
    margin: 0;
    font-size: 0.82rem;
  }
  .footer-sign {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-accent-bright);
  }
  .footer-copy {
    color: var(--color-text-on-dark-muted);
  }
  @media (max-width: 1080px) {
    .footer-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-newsletter {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .footer-status {
      min-height: 30px;
    }
    .footer-status-date {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
      padding-block: var(--space-5);
    }
    .footer-brand {
      display: grid;
      gap: var(--space-2);
    }
    .footer-logo {
      margin-bottom: 0;
    }
    .footer-logo img {
      width: 60px;
      height: 60px;
    }
    .footer-tagline {
      max-width: 36ch;
      margin: 0;
      font-size: 0.88rem;
      line-height: 1.6;
    }
    .footer-bottom-inner {
      justify-content: center;
      text-align: center;
    }
    .footer-newsletter {
      order: 2;
      grid-column: auto;
      padding-block: var(--space-4);
      border-block: 1px solid var(--color-border-on-dark);
    }
    .footer-zones {
      order: 3;
    }
    .footer-info {
      order: 4;
    }
    .footer-info ul,
    .footer-zones ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-4);
    }
    .footer-info a,
    .footer-zones a {
      width: 100%;
      min-height: 44px;
      font-size: 0.86rem;
      line-height: 1.35;
      white-space: normal;
    }
    .footer-newsletter p {
      max-width: 40ch;
      margin-bottom: var(--space-3);
      line-height: 1.6;
    }
    .footer-newsletter form {
      flex-wrap: nowrap;
    }
    .footer-newsletter input {
      flex-basis: auto;
    }
    .footer-newsletter button {
      min-width: 64px;
      padding-inline: var(--space-3);
    }
    .footer-bottom {
      padding-block: var(--space-3);
    }
    .footer-bottom p {
      font-size: 0.78rem;
    }
  }
</style>

<script>
  import { supabaseBrowser, supabaseConfigured } from '../lib/supabaseBrowser';

  const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.parentElement!.querySelector<HTMLElement>('[data-status]')!;

    function show(message: string, ok: boolean) {
      status.textContent = message;
      status.classList.toggle('is-ok', ok);
      status.classList.toggle('is-error', !ok);
      status.hidden = false;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = input.value.trim();
      if (!EMAIL_RE.test(email)) {
        show('Địa chỉ thư điện tử chưa hợp lệ, bạn kiểm tra lại nhé.', false);
        input.focus();
        return;
      }

      if (!supabaseConfigured) {
        show('Chức năng đăng ký chưa được cấu hình.', false);
        return;
      }

      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      status.hidden = true;

      const { data, error } = await supabaseBrowser.functions.invoke('subscribe-newsletter', {
        body: { email },
      });

      button.disabled = false;
      form.removeAttribute('aria-busy');

      if (error) {
        show('Đăng ký chưa được, bạn thử lại sau nhé.', false);
        return;
      }

      show(
        data?.alreadySubscribed
          ? 'Email này đã đăng ký bản tin rồi — cảm ơn bạn!'
          : data?.emailSent
            ? 'Đã đăng ký! 5 bài mới nhất đang được gửi tới hộp thư của bạn. 📬'
            : 'Đã đăng ký! Email đầu tiên có thể đến chậm một chút.',
        true,
      );
      form.reset();
    });
  });
</script>
