---
import { getCategories } from '../lib/categories';

const categories = await getCategories();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Công Nghệ Thường Nhật - Trang chủ">
        <img
          src="/assets/cong-nghe-thuong-nhat-logo-white.png"
          alt="Công Nghệ Thường Nhật"
          width="210"
          height="78"
        />
      </a>
      <p>
        Tin tức công nghệ, AI, startup và an ninh mạng — cập nhật nhanh, chọn lọc và dễ đọc.
      </p>
    </div>

    <nav class="footer-col" aria-label="Chuyên mục">
      <h2>Chuyên mục</h2>
      <ul>
        {categories.map((cat) => (
          <li><a href={`/category/${cat.slug}`}>{cat.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Thông tin và chính sách">
      <h2>Thông tin</h2>
      <ul>
        <li><a href="/gioi-thieu">Giới thiệu</a></li>
        <li><a href="/lien-he">Liên hệ</a></li>
        <li><a href="/chinh-sach-bien-tap">Chính sách biên tập</a></li>
        <li><a href="/chinh-sach-quyen-rieng-tu">Quyền riêng tư</a></li>
        <li><a href="/dieu-khoan-su-dung">Điều khoản sử dụng</a></li>
      </ul>
    </nav>

    <div class="footer-col footer-newsletter">
      <h2>Bản tin định kỳ</h2>
      <p>Nhận ngay 5 bài mới nhất và bản tin công nghệ vào sáng Thứ Hai hàng tuần.</p>
      <form data-newsletter novalidate>
        <label class="visually-hidden" for="footer-email">Thư điện tử của bạn</label>
        <input
          id="footer-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="Thư điện tử của bạn"
          required
        />
        <button type="submit" data-submit>Gửi</button>
      </form>
      <p class="newsletter-status" data-status hidden role="status" aria-live="polite"></p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>Mọi bản quyền thuộc về Công Nghệ Thường Nhật</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--nh-dark);
    color: #d3dbe6;
    margin-top: var(--space-7);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-6);
  }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    margin-bottom: var(--space-3);
  }
  .footer-logo img {
    width: min(200px, 100%);
    height: 70px;
    object-fit: contain;
    object-position: left center;
  }
  .footer-brand p {
    max-width: 42ch;
    color: #a8b2c3;
    font-size: 0.95rem;
  }
  .footer-col h2 {
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .footer-col li {
    min-width: 0;
  }
  .footer-col a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    /* nhãn ngắn ("AI") vẫn phải đạt vùng chạm tối thiểu 24px bề ngang */
    min-width: 24px;
    color: #d3dbe6;
    font-size: 0.92rem;
  }
  .footer-newsletter p {
    color: #a8b2c3;
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
  }
  .footer-newsletter form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .footer-newsletter input {
    min-width: 0;
    flex: 1 1 180px;
    min-height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-control);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    padding: 0 var(--space-3);
    font: inherit;
    font-size: 0.95rem;
  }
  .footer-newsletter input::placeholder {
    color: #94a0b4;
  }
  .footer-newsletter input:focus-visible {
    outline: 2px solid #8f91f0;
    outline-offset: 1px;
  }
  .footer-newsletter button {
    flex: 0 0 auto;
    min-height: 44px;
    min-width: 72px;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--primary);
    color: var(--primary-contrast);
    font-family: var(--font-head);
    font-weight: 600;
    padding: 0 var(--space-4);
    cursor: pointer;
    transition: background var(--dur-fast) ease;
  }
  .footer-newsletter button:hover:not(:disabled) {
    background: #5a5ce0;
  }
  .footer-newsletter button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .newsletter-status {
    margin: var(--space-2) 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .newsletter-status.is-ok {
    color: #7ef0d0;
  }
  .newsletter-status.is-error {
    color: #fca5a5;
  }
  .footer-col a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-bottom {
    border-top: 1px solid rgba(148, 163, 184, 0.18);
    padding-block: var(--space-4);
  }
  .footer-bottom p {
    margin: 0;
    color: #a8b2c3;
    font-size: 0.85rem;
    text-align: center;
  }
  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
      padding-block: var(--space-6) var(--space-5);
    }
  }
</style>

<script>
  import { supabaseBrowser, supabaseConfigured } from '../lib/supabaseBrowser';

  const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.parentElement!.querySelector<HTMLElement>('[data-status]')!;

    function show(message: string, ok: boolean) {
      status.textContent = message;
      status.classList.toggle('is-ok', ok);
      status.classList.toggle('is-error', !ok);
      status.hidden = false;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = input.value.trim();
      if (!EMAIL_RE.test(email)) {
        show('Địa chỉ thư điện tử chưa hợp lệ, bạn kiểm tra lại nhé.', false);
        input.focus();
        return;
      }

      if (!supabaseConfigured) {
        show('Chức năng đăng ký chưa được cấu hình.', false);
        return;
      }

      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      status.hidden = true;

      const { data, error } = await supabaseBrowser.functions.invoke('subscribe-newsletter', {
        body: { email },
      });

      button.disabled = false;
      form.removeAttribute('aria-busy');

      if (error) {
        show('Đăng ký chưa được, bạn thử lại sau nhé.', false);
        return;
      }

      show(
        data?.alreadySubscribed
          ? 'Email này đã đăng ký bản tin rồi — cảm ơn bạn!'
          : data?.emailSent
            ? 'Đã đăng ký! 5 bài mới nhất đang được gửi tới hộp thư của bạn. 📬'
            : 'Đã đăng ký! Email đầu tiên có thể đến chậm một chút.',
        true,
      );
      form.reset();
    });
  });
</script>
