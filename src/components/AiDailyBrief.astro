---
import type { Post } from '../lib/posts';
import { postSlug } from '../lib/posts';

export interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="brief" aria-label="Bản tin AI hằng ngày">
    <div class="brief-bg">
      <div class="brief-head">
        <div>
          <span class="brief-kicker"><span></span>Bản tin AI hằng ngày</span>
          <h2>Tổng hợp AI trong ngày</h2>
          <p>
            Những chuyển động đáng chú ý nhất về mô hình, hạ tầng và ứng dụng AI,
            được chắt lọc để đọc nhanh nhưng vẫn có ngữ cảnh.
          </p>
        </div>
        <a href="/category/ai" class="brief-link">Xem thêm tin AI →</a>
      </div>

      <div class="brief-grid">
        <article class="brief-card">
          <div class="brief-icon">60</div>
          <h3>Tóm tắt 60 giây</h3>
          <p>{posts[0]?.data.excerpt}</p>
          {posts[0] && <a href={`/article/${postSlug(posts[0])}`}>{posts[0].data.title}</a>}
        </article>
        <article class="brief-card">
          <div class="brief-icon">AI</div>
          <h3>Góc nhìn chuyên sâu</h3>
          <p>
            Đặt tin tức vào bối cảnh tác động đến doanh nghiệp, developer và người dùng cuối.
          </p>
          {posts[1] && <a href={`/article/${postSlug(posts[1])}`}>{posts[1].data.title}</a>}
        </article>
        <article class="brief-card">
          <div class="brief-icon">↗</div>
          <h3>Theo dõi xu hướng</h3>
          <p>
            Theo dõi các chủ đề nóng như AI agent, chip AI, dữ liệu cá nhân và tự động hóa.
          </p>
          {posts[2] && <a href={`/article/${postSlug(posts[2])}`}>{posts[2].data.title}</a>}
        </article>
      </div>
    </div>
  </section>
)}

<style>
  .brief {
    padding: var(--space-6) 0 var(--space-7);
  }
  .brief-bg {
    position: relative;
    overflow: hidden;
    border-radius: 6px 32px 6px 32px;
    padding: clamp(24px, 4vw, 48px);
    color: #fff;
    background: var(--nh-dark);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .brief-bg::after {
    content: '02';
    position: absolute;
    right: clamp(18px, 3vw, 42px);
    top: -0.25em;
    color: rgba(255, 255, 255, 0.045);
    font-family: var(--font-head);
    font-size: clamp(7rem, 15vw, 12rem);
    font-weight: 800;
    line-height: 1;
    pointer-events: none;
  }
  .brief-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .brief-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: #cdcefb;
    font-family: var(--font-head);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .brief-kicker span {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: #8f91f0;
  }
  .brief-head h2 {
    color: #fff;
    font-size: var(--fs-section);
    margin: var(--space-3) 0 var(--space-2);
  }
  .brief-head p {
    max-width: 62ch;
    margin: 0;
    color: #cbd5e1;
    font-size: 0.98rem;
  }
  .brief-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-2);
    border-radius: var(--radius-control);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
  }
  .brief-link:hover {
    color: #cdcefb;
  }
  .brief-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .brief-card {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  .brief-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .brief-icon {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-control);
    background: var(--primary);
    color: var(--primary-contrast);
    font-family: var(--font-head);
    font-weight: 700;
  }
  .brief-card h3 {
    color: #fff;
    font-size: 1.08rem;
    margin-bottom: var(--space-2);
  }
  .brief-card p {
    color: #cbd5e1;
    font-size: 0.93rem;
    line-height: 1.65;
  }
  .brief-card a {
    display: inline-block;
    color: #7ee7f6;
    font-family: var(--font-head);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: break-word;
  }
  .brief-card a:hover {
    color: #c8f7fc;
  }

  @media (max-width: 900px) {
    .brief-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
  @media (max-width: 820px) {
    .brief-head {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3);
    }
    .brief-link {
      margin-left: calc(var(--space-2) * -1);
    }
  }
  @media (max-width: 640px) {
    .brief {
      padding: var(--space-5) 0 var(--space-6);
    }
    .brief-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
