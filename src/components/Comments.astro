---
export interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section class="comments" aria-label="Bình luận" data-comments data-slug={slug}>
  <div class="container comments-inner">
    <div class="comments-header">
      <div>
        <p class="comments-eyebrow">Thảo luận</p>
        <h2 class="comments-title">Bình luận <span data-comment-count></span></h2>
      </div>
      <div class="comment-toolbar" data-toolbar hidden>
        <label>
          <span class="visually-hidden">Sắp xếp bình luận</span>
          <select data-sort aria-label="Sắp xếp bình luận">
            <option value="newest">Mới nhất</option>
            <option value="oldest">Cũ nhất</option>
          </select>
        </label>
      </div>
    </div>

    <form class="comment-composer" data-composer hidden>
      <span class="composer-avatar" data-me-avatar aria-hidden="true">U</span>
      <div class="composer-main">
        <label class="visually-hidden" for={`comment-${slug}`}>Viết bình luận của bạn</label>
        <textarea
          id={`comment-${slug}`}
          name="content"
          rows="1"
          maxlength="4000"
          placeholder="Viết bình luận của bạn…"
          aria-describedby={`comment-hint-${slug}`}
          required
        ></textarea>
        <div class="composer-actions">
          <span id={`comment-hint-${slug}`} class="composer-as">
            <strong data-me-name></strong> · Ctrl + Enter để gửi
          </span>
          <button type="submit" disabled>
            <span data-submit-label>Đăng</span>
            <span class="button-spinner" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </form>

    <p class="comment-login" data-login-prompt hidden>
      <a data-login-link href="/login">Đăng nhập</a> để tham gia bình luận.
    </p>
    <p class="comment-feedback" data-feedback role="status" aria-live="polite" hidden></p>
    <div class="comment-status" data-status role="status" aria-live="polite">
      <span class="status-spinner" aria-hidden="true"></span>
      <span data-status-text>Đang tải bình luận…</span>
    </div>
    <div class="comment-list" data-list aria-live="polite"></div>
    <button type="button" class="load-more" data-load-more hidden>Xem thêm bình luận</button>
  </div>
</section>

<!-- Style global (khóa trong .comments) vì các thẻ bình luận được tạo động
     bằng JS nên không nhận được style scoped của Astro. -->
<style is:global>
  .comments [hidden] {
    display: none !important;
  }
  .comments {
    background: var(--surface-low);
    border-top: 1px solid var(--border);
    margin-top: var(--space-6);
    padding-block: var(--space-6) var(--space-7);
  }
  /* Cột bình luận khớp đúng chiều rộng cột bài viết ở trên. */
  .comments .comments-inner {
    max-width: var(--maxw);
    display: grid;
    grid-template-columns: minmax(0, 700px) minmax(260px, 320px);
    column-gap: clamp(32px, 4vw, 64px);
  }
  .comments .comments-inner > * {
    grid-column: 1;
    min-width: 0;
  }
  .comments .comments-title {
    font-size: 1.35rem;
    margin: 0 0 var(--space-5);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .comments .comments-title span {
    color: var(--text-muted);
    font-weight: 600;
    font-size: 1rem;
  }
  .comments .comments-header {
    grid-column: 1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }
  .comments .comments-eyebrow {
    margin: 0 0 3px;
    color: var(--primary);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Ô soạn bình luận */
  .comments .comment-composer {
    display: flex;
    align-items: start;
    gap: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .comments .composer-main {
    flex: 1 1 auto;
    width: 0;
    min-width: 0;
  }
  .comments .composer-avatar {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-pill);
    display: grid;
    place-items: center;
    background: var(--primary);
    color: var(--primary-contrast);
    font-family: var(--font-head);
    font-weight: 700;
  }
  .comments textarea {
    width: 100%;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    padding: var(--space-3);
    font: inherit;
    color: var(--text);
    background: var(--surface);
    min-height: 48px;
    max-height: 180px;
    resize: none;
    overflow-y: hidden;
  }
  .comments textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--ring);
  }
  .comments .composer-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 9px;
  }
  .comments .composer-as {
    font-size: 0.86rem;
    color: var(--text-muted);
  }
  .comments .composer-as strong {
    color: var(--text);
  }
  .comments .comment-composer .composer-actions button,
  .comments .comment-reply button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: start;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--primary);
    color: var(--primary-contrast);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1;
    padding: 0 var(--space-5);
    cursor: pointer;
    appearance: none;
    transition: background var(--dur-fast) ease;
  }
  .comments .comment-composer .composer-actions button:disabled {
    background: var(--surface-container);
    color: var(--text-muted);
    box-shadow: none;
  }
  .comments .comment-composer.is-submitting .button-spinner {
    display: block;
  }
  .comments .button-spinner,
  .comments .status-spinner {
    display: none;
    width: 15px;
    height: 15px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: comment-spin 0.7s linear infinite;
  }
  .comments .status-spinner {
    display: inline-block;
  }
  .comments .comment-composer .composer-actions button:hover:not([disabled]),
  .comments .comment-reply button:hover:not([disabled]) {
    background: var(--primary-strong);
  }
  .comments .comment-composer .composer-actions button:focus-visible,
  .comments .comment-reply button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .comments button[disabled] {
    opacity: 0.55;
    cursor: default;
    transform: none;
    box-shadow: none;
  }

  /* Nhắc đăng nhập */
  .comments .comment-login {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    color: var(--text-soft);
  }
  .comments .comment-login a {
    color: var(--primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .comments .comment-status,
  .comments .comment-feedback {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .comments .comment-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 58px;
  }
  /* Ba trạng thái dữ liệu được phân biệt bằng thị giác, không chỉ bằng chữ. */
  .comments .comment-status.is-empty,
  .comments .comment-status.is-error {
    padding: var(--space-4);
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .comments .comment-status.is-error {
    border-color: #fca5a5;
    background: var(--error-bg);
    color: var(--error);
  }
  .comments .comment-feedback {
    padding: var(--space-2) var(--space-3);
    margin: calc(var(--space-3) * -1) 0 var(--space-5) 54px;
    border-radius: var(--radius-control);
    background: var(--primary-soft);
    color: var(--text-soft);
  }
  .comments .comment-feedback.is-error {
    background: var(--error-bg);
    color: var(--error);
  }
  .comments .comment-toolbar {
    margin: 0;
  }
  .comments .comment-toolbar label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .comments .comment-toolbar select {
    font: inherit;
    font-size: 0.9rem;
    min-height: 40px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-control);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  /* Danh sách bình luận */
  .comments .comment-list {
    display: grid;
    gap: var(--space-5);
  }
  .comments .comment {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    position: relative;
  }
  .comments .comment-avatar {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    display: grid;
    place-items: center;
    background: var(--primary);
    color: var(--primary-contrast);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    user-select: none;
  }
  .comments .comment-main {
    flex: 1 1 auto;
    min-width: 0;
  }
  .comments .comment-bubble {
    padding: 1px 42px 0 0;
    position: relative;
  }
  .comments .comment-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }
  .comments .comment-author {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .comments .comment-badge {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--primary);
    background: var(--primary-soft);
    border-radius: var(--radius-pill);
    padding: 2px 8px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .comments .comment-time {
    font-size: var(--fs-meta);
    color: var(--text-muted);
  }
  .comments .comment-body {
    color: #1e293b;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .comments .comment-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
  }
  .comments .comment-actions button {
    display: inline-flex;
    align-items: center;
    background: none;
    border: 0;
    border-radius: var(--radius-control);
    min-height: 40px;
    padding: 0 var(--space-2);
    margin-left: calc(var(--space-2) * -1);
    color: var(--text-muted);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }
  .comments .comment-menu-button {
    position: absolute;
    right: 0;
    top: -5px;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1.25rem;
    line-height: 1;
  }
  .comments .comment-menu-button:hover,
  .comments .comment-menu-button[aria-expanded='true'] {
    background: var(--surface-low);
    color: var(--text);
  }
  .comments .comment-menu {
    position: absolute;
    z-index: 5;
    right: 0;
    top: 40px;
    min-width: 170px;
    padding: var(--space-1);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-elevated);
  }
  .comments .comment-menu button {
    display: block;
    width: 100%;
    min-height: 40px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--text);
    text-align: left;
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .comments .comment-menu button:hover {
    background: var(--surface-low);
  }
  .comments .comment-menu .link-danger {
    color: var(--error);
  }
  .comments .comment-actions button:hover {
    color: var(--primary);
    background: var(--primary-softer);
  }
  .comments .comment-actions button.link-danger:hover {
    color: var(--error);
    background: var(--error-bg);
  }

  /* Trả lời (thụt vào 1 cấp) */
  .comments .comment-replies {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-left: var(--space-5);
    border-left: 2px solid var(--border);
  }
  .comments .replies-toggle,
  .comments .load-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--primary);
    font-family: var(--font-head);
    font-weight: 600;
    cursor: pointer;
  }
  .comments .replies-toggle {
    margin: var(--space-1) 0 0 40px;
    padding-inline: var(--space-2);
  }
  .comments .load-more {
    display: flex;
    margin: var(--space-5) auto 0;
    padding: 0 var(--space-5);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }
  .comments .load-more:hover {
    background: var(--surface-container);
  }
  .comments .comment.is-new {
    animation: comment-arrive var(--dur-normal) ease both;
  }
  .comments .comment-replies .comment-avatar {
    width: 32px;
    height: 32px;
    font-size: 0.85rem;
  }

  /* Form trả lời inline */
  .comments .comment-reply {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .comments .replying-to {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.84rem;
  }
  .comments .reply-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .comments .reply-cancel {
    background: transparent !important;
    color: var(--text-soft) !important;
    box-shadow: none !important;
  }
  @keyframes comment-spin {
    to { transform: rotate(360deg); }
  }
  @keyframes comment-arrive {
    from { opacity: 0; transform: translateY(8px); }
  }

  @media (max-width: 560px) {
    .comments {
      padding-block: var(--space-5) var(--space-6);
    }
    .comments .comments-header {
      align-items: flex-start;
    }
    .comments .comment-composer {
      gap: var(--space-2);
      padding: var(--space-3);
    }
    .comments .composer-avatar,
    .comments .comment-avatar {
      width: 36px;
      height: 36px;
      font-size: 0.85rem;
    }
    .comments .comment-feedback {
      margin-left: 0;
    }
    .comments .comment {
      gap: var(--space-2);
    }
    .comments .comment-replies {
      padding-left: var(--space-3);
      margin-left: 0;
    }
    .comments .replies-toggle {
      margin-left: 0;
    }
    .comments .composer-actions {
      align-items: stretch;
      flex-direction: column;
    }
    .comments .comment-composer .composer-actions button {
      width: 100%;
    }
    .comments .comment-bubble {
      padding-right: 40px;
    }
  }
  @media (max-width: 1180px) {
    .comments .comments-inner {
      display: block;
      max-width: 700px;
    }
  }
</style>

<script>
  import { supabaseBrowser, getCurrentUser } from '../lib/supabaseBrowser';

  const root = document.querySelector<HTMLElement>('[data-comments]');
  if (root) {
    const slug = root.dataset.slug || '';
    const listEl = root.querySelector<HTMLElement>('[data-list]')!;
    const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
    const statusTextEl = root.querySelector<HTMLElement>('[data-status-text]')!;
    const feedbackEl = root.querySelector<HTMLElement>('[data-feedback]')!;
    const countEl = root.querySelector<HTMLElement>('[data-comment-count]')!;
    const composer = root.querySelector<HTMLFormElement>('[data-composer]')!;
    const loginPrompt = root.querySelector<HTMLElement>('[data-login-prompt]')!;
    const loginLink = root.querySelector<HTMLAnchorElement>('[data-login-link]')!;
    const meNameEl = root.querySelector<HTMLElement>('[data-me-name]')!;
    const meAvatarEl = root.querySelector<HTMLElement>('[data-me-avatar]')!;
    const toolbar = root.querySelector<HTMLElement>('[data-toolbar]')!;
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const loadMoreBtn = root.querySelector<HTMLButtonElement>('[data-load-more]')!;
    const PAGE_SIZE = 10;
    let visibleRootCount = PAGE_SIZE;
    let newlyAddedId = '';

    sortSelect.addEventListener('change', () => {
      sortNewest = sortSelect.value === 'newest';
      visibleRootCount = PAGE_SIZE;
      loadComments(false);
    });

    type Me = { id: string; name: string; role: string } | null;
    let me: Me = null;

    type Comment = {
      id: string;
      parent_id: string | null;
      user_id: string;
      author_name: string;
      author_role: string;
      content: string;
      created_at: string;
    };

    let sortNewest = true;

    const canModerate = () => me?.role === 'admin' || me?.role === 'moderator';

    function formatTime(iso: string): string {
      const seconds = Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 1000));
      if (seconds < 45) return 'Vừa xong';
      if (seconds < 3600) return `${Math.floor(seconds / 60)} phút`;
      if (seconds < 86400) return `${Math.floor(seconds / 3600)} giờ`;
      if (seconds < 604800) return `${Math.floor(seconds / 86400)} ngày`;
      return new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' })
        .format(new Date(iso));
    }

    function initial(name: string): string {
      const t = (name || '').trim();
      return t ? t.charAt(0).toUpperCase() : 'U';
    }

    function showFeedback(message: string, error = false) {
      feedbackEl.textContent = message;
      feedbackEl.classList.toggle('is-error', error);
      feedbackEl.hidden = false;
    }

    function closeMenus() {
      root.querySelectorAll<HTMLElement>('.comment-menu').forEach((menu) => menu.hidden = true);
      root.querySelectorAll<HTMLButtonElement>('.comment-menu-button').forEach((button) => {
        button.setAttribute('aria-expanded', 'false');
      });
    }

    function buildComment(c: Comment, isReply: boolean): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'comment';

      const avatar = document.createElement('div');
      avatar.className = 'comment-avatar';
      avatar.textContent = initial(c.author_name);

      const main = document.createElement('div');
      main.className = 'comment-main';

      const bubble = document.createElement('div');
      bubble.className = 'comment-bubble';

      const head = document.createElement('div');
      head.className = 'comment-head';
      const author = document.createElement('span');
      author.className = 'comment-author';
      author.textContent = c.author_name;
      head.appendChild(author);
      if (['admin', 'editor', 'author', 'moderator'].includes(c.author_role)) {
        const badge = document.createElement('span');
        badge.className = 'comment-badge';
        const roleLabels: Record<string, string> = {
          admin: 'Quản trị viên',
          editor: 'Biên tập viên',
          author: 'Cộng tác viên',
          moderator: 'Kiểm duyệt viên',
        };
        badge.textContent = roleLabels[c.author_role];
        head.appendChild(badge);
      }
      const time = document.createElement('span');
      time.className = 'comment-time';
      time.textContent = formatTime(c.created_at);
      time.title = new Date(c.created_at).toLocaleString('vi-VN');
      head.appendChild(time);

      const body = document.createElement('div');
      body.className = 'comment-body';
      body.textContent = c.content;

      bubble.appendChild(head);
      bubble.appendChild(body);

      const menuButton = document.createElement('button');
      menuButton.type = 'button';
      menuButton.className = 'comment-menu-button';
      menuButton.setAttribute('aria-label', `Tùy chọn bình luận của ${c.author_name}`);
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.textContent = '•••';

      const menu = document.createElement('div');
      menu.className = 'comment-menu';
      menu.hidden = true;
      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.textContent = 'Sao chép nội dung';
      copyButton.addEventListener('click', async () => {
        await navigator.clipboard.writeText(c.content);
        closeMenus();
        showFeedback('Đã sao chép nội dung bình luận.');
      });
      menu.appendChild(copyButton);

      if (me && (me.id === c.user_id || canModerate())) {
        const delButton = document.createElement('button');
        delButton.type = 'button';
        delButton.className = 'link-danger';
        delButton.textContent = 'Xóa bình luận';
        delButton.addEventListener('click', () => {
          closeMenus();
          deleteComment(c.id);
        });
        menu.appendChild(delButton);
      }
      menuButton.addEventListener('click', (event) => {
        event.stopPropagation();
        const willOpen = menu.hidden;
        closeMenus();
        menu.hidden = !willOpen;
        menuButton.setAttribute('aria-expanded', String(willOpen));
        if (willOpen) menu.querySelector<HTMLButtonElement>('button')?.focus();
      });
      bubble.appendChild(menuButton);
      bubble.appendChild(menu);
      main.appendChild(bubble);

      const actions = document.createElement('div');
      actions.className = 'comment-actions';

      // Trả lời: chỉ ở bình luận gốc, và phải đăng nhập.
      if (me && !isReply) {
        const replyBtn = document.createElement('button');
        replyBtn.type = 'button';
        replyBtn.textContent = 'Trả lời';
        replyBtn.addEventListener('click', () => toggleReplyForm(main, c.id));
        actions.appendChild(replyBtn);
      }

      if (actions.childElementCount) main.appendChild(actions);

      wrap.appendChild(avatar);
      wrap.appendChild(main);
      if (c.id === newlyAddedId) wrap.classList.add('is-new');
      return wrap;
    }

    function toggleReplyForm(parentEl: HTMLElement, parentId: string) {
      const existing = parentEl.querySelector('.comment-reply');
      if (existing) {
        existing.remove();
        return;
      }
      const form = document.createElement('form');
      form.className = 'comment-reply';
      const context = document.createElement('p');
      context.className = 'replying-to';
      context.textContent = `Đang trả lời ${parentEl.querySelector('.comment-author')?.textContent || 'bình luận này'}`;
      const textarea = document.createElement('textarea');
      textarea.rows = 2;
      textarea.maxLength = 4000;
      textarea.required = true;
      textarea.placeholder = 'Viết trả lời…';
      textarea.setAttribute('aria-label', context.textContent);
      const btn = document.createElement('button');
      btn.type = 'submit';
      btn.textContent = 'Gửi trả lời';
      const cancel = document.createElement('button');
      cancel.type = 'button';
      cancel.className = 'reply-cancel';
      cancel.textContent = 'Hủy';
      cancel.addEventListener('click', () => form.remove());
      const controls = document.createElement('div');
      controls.className = 'reply-controls';
      controls.append(cancel, btn);
      form.appendChild(context);
      form.appendChild(textarea);
      form.appendChild(controls);
      textarea.addEventListener('input', () => {
        textarea.style.height = 'auto';
        textarea.style.height = `${Math.min(textarea.scrollHeight, 180)}px`;
        textarea.style.overflowY = textarea.scrollHeight > 180 ? 'auto' : 'hidden';
      });
      textarea.addEventListener('keydown', (event) => {
        if (event.ctrlKey && event.key === 'Enter') form.requestSubmit();
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const content = textarea.value.trim();
        if (!content) return;
        btn.disabled = true;
        btn.textContent = 'Đang gửi…';
        const success = await insertComment(content, parentId);
        btn.disabled = false;
        btn.textContent = 'Gửi trả lời';
        if (success) form.remove();
      });
      parentEl.appendChild(form);
      textarea.focus();
    }

    async function insertComment(content: string, parentId: string | null): Promise<boolean> {
      if (!me) return false;
      feedbackEl.hidden = true;
      const { data, error } = await supabaseBrowser.from('comments').insert({
        post_slug: slug,
        parent_id: parentId,
        user_id: me.id,
        author_name: me.name,
        author_role: me.role,
        content,
      }).select('id').single();
      if (error) {
        showFeedback('Không gửi được bình luận. Nội dung của bạn vẫn được giữ lại để thử lại.', true);
        return false;
      }
      newlyAddedId = data?.id || '';
      await loadComments(false);
      showFeedback(parentId ? 'Đã đăng câu trả lời.' : 'Đã đăng bình luận.');
      return true;
    }

    async function deleteComment(id: string) {
      const confirmed = await (window as any).siteConfirm({
        title: 'Xóa bình luận?',
        message: 'Bình luận này sẽ bị xóa và không thể khôi phục.',
        confirmText: 'Xóa bình luận',
      });
      if (!confirmed) return;
      const { error } = await supabaseBrowser.from('comments').delete().eq('id', id);
      if (error) {
        showFeedback('Không thể xóa bình luận. Vui lòng thử lại.', true);
        return;
      }
      await loadComments(false);
      showFeedback('Đã xóa bình luận.');
    }

    async function loadComments(showLoading = true) {
      if (showLoading) {
        statusEl.hidden = false;
        statusEl.className = 'comment-status is-loading';
        listEl.setAttribute('aria-busy', 'true');
        statusTextEl.textContent = 'Đang tải bình luận…';
      }
      const { data, error } = await supabaseBrowser
        .from('comments')
        .select('id, parent_id, user_id, author_name, author_role, content, created_at')
        .eq('post_slug', slug)
        .order('created_at', { ascending: true });

      listEl.removeAttribute('aria-busy');

      if (error) {
        statusEl.hidden = false;
        statusEl.className = 'comment-status is-error';
        statusEl.querySelector('.status-spinner')?.remove();
        statusTextEl.textContent = 'Không tải được bình luận. Vui lòng tải lại trang.';
        return;
      }

      const comments = (data || []) as Comment[];
      const roots = comments.filter((c) => !c.parent_id);
      roots.sort((a, b) => {
        const diff = new Date(a.created_at).getTime() - new Date(b.created_at).getTime();
        return sortNewest ? -diff : diff;
      });
      const repliesByParent = new Map<string, Comment[]>();
      for (const c of comments) {
        if (c.parent_id) {
          const arr = repliesByParent.get(c.parent_id) || [];
          arr.push(c);
          repliesByParent.set(c.parent_id, arr);
        }
      }

      countEl.textContent = comments.length ? `(${comments.length})` : '';
      toolbar.hidden = roots.length === 0;
      listEl.innerHTML = '';
      loadMoreBtn.hidden = roots.length <= visibleRootCount;

      if (!roots.length) {
        statusEl.hidden = false;
        statusEl.className = 'comment-status is-empty';
        statusEl.querySelector('.status-spinner')?.remove();
        statusTextEl.textContent = 'Chưa có bình luận nào. Hãy mở đầu cuộc trò chuyện!';
        return;
      }
      statusEl.className = 'comment-status';
      statusEl.hidden = true;

      for (const rootComment of roots.slice(0, visibleRootCount)) {
        const node = buildComment(rootComment, false);
        const replies = repliesByParent.get(rootComment.id) || [];
        if (replies.length) {
          const repliesWrap = document.createElement('div');
          repliesWrap.className = 'comment-replies';
          const initiallyVisible = 2;
          for (const [index, r] of replies.entries()) {
            const replyNode = buildComment(r, true);
            replyNode.hidden = index >= initiallyVisible;
            repliesWrap.appendChild(replyNode);
          }
          const main = node.querySelector('.comment-main');
          (main || node).appendChild(repliesWrap);
          if (replies.length > initiallyVisible) {
            const toggle = document.createElement('button');
            toggle.type = 'button';
            toggle.className = 'replies-toggle';
            toggle.textContent = `Xem thêm ${replies.length - initiallyVisible} câu trả lời`;
            toggle.setAttribute('aria-expanded', 'false');
            toggle.addEventListener('click', () => {
              const expanded = toggle.getAttribute('aria-expanded') === 'true';
              repliesWrap.querySelectorAll<HTMLElement>('.comment').forEach((reply, index) => {
                reply.hidden = !expanded ? false : index >= initiallyVisible;
              });
              toggle.setAttribute('aria-expanded', String(!expanded));
              toggle.textContent = expanded ? `Xem thêm ${replies.length - initiallyVisible} câu trả lời` : 'Ẩn câu trả lời';
            });
            (main || node).appendChild(toggle);
          }
        }
        listEl.appendChild(node);
      }
      newlyAddedId = '';
    }

    // Khởi tạo
    (async () => {
      me = await getCurrentUser();
      if (me) {
        composer.hidden = false;
        meNameEl.textContent = me.name;
        meAvatarEl.textContent = initial(me.name);
      } else {
        loginPrompt.hidden = false;
        loginLink.href = '/login?next=' + encodeURIComponent(window.location.pathname);
      }

      const composerTextarea = composer.querySelector<HTMLTextAreaElement>('textarea')!;
      const composerButton = composer.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const submitLabel = composer.querySelector<HTMLElement>('[data-submit-label]')!;
      const syncComposer = () => {
        composerTextarea.style.height = 'auto';
        composerTextarea.style.height = `${Math.min(composerTextarea.scrollHeight, 180)}px`;
        composerTextarea.style.overflowY = composerTextarea.scrollHeight > 180 ? 'auto' : 'hidden';
        composerButton.disabled = !composerTextarea.value.trim() || composer.classList.contains('is-submitting');
      };
      composerTextarea.addEventListener('input', syncComposer);
      composerTextarea.addEventListener('keydown', (event) => {
        if (event.ctrlKey && event.key === 'Enter') composer.requestSubmit();
      });
      composer.addEventListener('submit', async (event) => {
        event.preventDefault();
        const content = composerTextarea.value.trim();
        if (!content) return;
        composer.classList.add('is-submitting');
        composerButton.disabled = true;
        submitLabel.textContent = 'Đang đăng';
        const success = await insertComment(content, null);
        if (success) composerTextarea.value = '';
        composer.classList.remove('is-submitting');
        submitLabel.textContent = 'Đăng';
        syncComposer();
      });

      await loadComments();
    })();

    loadMoreBtn.addEventListener('click', () => {
      visibleRootCount += PAGE_SIZE;
      loadComments(false);
    });
    document.addEventListener('click', closeMenus);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenus();
    });
  }
</script>
