---
import { getCategories } from '../lib/categories';
import SearchBox from './SearchBox.astro';

// Đánh dấu mục điều hướng đang mở (chỉ phục vụ hiển thị, không đổi route).
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = path === '/';
const activeCategory = path.startsWith('/category/') ? path.split('/')[2] : '';
const categories = (await getCategories()).filter((category) => category.showInHeader !== false);
const primaryCategories = categories.slice(0, 7);
const moreCategories = categories.slice(7);
const moreIsActive = moreCategories.some((category) => category.slug === activeCategory);
---

<!-- Điều hướng: ≥1081px dùng hàng chuyên mục trong header; nhỏ hơn thì dùng
     drawer + dải chip trên trang. -->
<header class="site-header">
  <div class="container header-inner">
    <div class="header-left">
      <a href="/" class="logo" aria-label="Công Nghệ Thường Nhật - Trang chủ">
        <img
          src="/assets/cong-nghe-thuong-nhat-logo.webp"
          alt="Công Nghệ Thường Nhật"
          width="190"
          height="70"
        />
      </a>
    </div>

    <div class="header-right">
      <div class="auth-actions" aria-label="Tài khoản">
        <a href="/login" class="auth-login" data-auth-login>Đăng nhập</a>
        <a href="/login?mode=signup" class="auth-signup" data-auth-signup>Đăng ký</a>
      </div>
      <button
        class="nav-toggle"
        type="button"
        aria-label="Mở menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Điều hướng chuyên mục cho màn hình rộng -->
  <nav class="primary-nav" aria-label="Chuyên mục">
    <div class="container primary-nav-inner">
      <ul>
        <li><a href="/" aria-current={isHome ? 'page' : undefined}>Trang chủ</a></li>
        {primaryCategories.map((cat) => (
          <li>
            <a
              href={`/category/${cat.slug}`}
              aria-current={activeCategory === cat.slug ? 'page' : undefined}
            >{cat.label}</a>
          </li>
        ))}
        {moreCategories.length > 0 && (
          <li class="primary-nav-more">
            <details data-category-more>
              <summary class:list={{ active: moreIsActive }}>
                Thêm
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m4 6 4 4 4-4"></path>
                </svg>
              </summary>
              <ul class="more-menu">
                {moreCategories.map((cat) => (
                  <li>
                    <a
                      href={`/category/${cat.slug}`}
                      aria-current={activeCategory === cat.slug ? 'page' : undefined}
                    >
                      <span>{cat.label}</span>
                      <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M6 3h7v7M13 3 5 11"></path>
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        )}
      </ul>
      <a href="/search" class="primary-nav-search">Tìm kiếm nâng cao →</a>
    </div>
  </nav>

  <!-- Lớp chứa drawer: fixed + overflow hidden nên panel off-canvas không bao
       giờ nới rộng chiều ngang tài liệu. -->
  <div class="drawer-layer">
  <div class="drawer-backdrop" data-backdrop></div>
  <aside
    id="mobile-nav"
    class="mobile-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Menu di động"
    aria-hidden="true"
    inert
  >
    <div class="drawer-top">
      <span class="drawer-title">Menu</span>
      <button class="drawer-close" type="button" data-drawer-close aria-label="Đóng menu">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <!-- Tài khoản (đầu sidebar) -->
    <div class="drawer-account">
      <div class="account-guest" data-auth-guest>
        <a href="/login" class="btn-outline">Đăng nhập</a>
        <a href="/login?mode=signup" class="btn-solid">Đăng ký</a>
      </div>
      <a href="/account" class="account-card" data-auth-user hidden>
        <span class="account-avatar" data-user-initial>N</span>
        <span class="account-info">
          <strong data-user-name>Tài khoản</strong>
          <small data-user-email></small>
        </span>
        <svg class="account-chevron" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <div class="drawer-content">
      <!-- Tìm kiếm + nút mở danh mục -->
      <div class="drawer-search-row">
        <div class="drawer-search">
          <SearchBox variant="header" inputId="q-mobile-drawer" />
        </div>
        <button
          class="drawer-category-toggle"
          type="button"
          aria-label="Mở danh mục"
          aria-expanded="false"
          aria-controls="drawer-categories"
          data-category-toggle
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="4" y="4" width="6" height="6" rx="1"></rect>
            <rect x="14" y="4" width="6" height="6" rx="1"></rect>
            <rect x="4" y="14" width="6" height="6" rx="1"></rect>
            <rect x="14" y="14" width="6" height="6" rx="1"></rect>
          </svg>
        </button>
      </div>

      <nav id="drawer-categories" class="drawer-categories" aria-label="Chuyên mục" hidden>
        <span class="drawer-section-title">Chuyên mục</span>
        <ul>
          {categories.map((cat) => (
            <li><a href={`/category/${cat.slug}`}>{cat.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="drawer-info-nav" aria-label="Thông tin">
        <span class="drawer-section-title">Thông tin</span>
        <ul>
          <li><a href="/gioi-thieu">Giới thiệu</a></li>
          <li><a href="/lien-he">Liên hệ</a></li>
          <li><a href="/chinh-sach-bien-tap">Chính sách biên tập</a></li>
          <li><a href="/chinh-sach-quyen-rieng-tu">Quyền riêng tư</a></li>
          <li><a href="/dieu-khoan-su-dung">Điều khoản sử dụng</a></li>
        </ul>
      </nav>
    </div>

    <!-- Đăng xuất (cuối sidebar) -->
    <div class="drawer-footer">
      <button type="button" class="btn-logout" data-drawer-logout hidden>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M15 12H3m0 0l4-4m-4 4l4 4M13 4h6a1 1 0 011 1v14a1 1 0 01-1 1h-6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Đăng xuất
      </button>
    </div>
  </aside>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 64px;
    max-width: var(--maxw);
  }
  .header-left {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .logo {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
  }
  .logo img {
    display: block;
    width: clamp(142px, 15vw, 186px);
    height: 44px;
    object-fit: contain;
    object-position: left center;
  }
  .header-right {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .auth-actions {
    display: flex;
    gap: var(--space-2);
  }
  .auth-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-control);
    font-family: var(--font-head);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1;
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .auth-login {
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
  }
  .auth-login:hover {
    background: var(--surface-low);
  }
  .auth-signup {
    background: var(--primary);
    color: var(--primary-contrast);
  }
  .auth-signup:hover {
    background: var(--primary-strong);
  }

  /* ===== Hàng chuyên mục (desktop) ===== */
  .primary-nav {
    display: none;
    border-top: 1px solid var(--border);
  }
  .primary-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
    flex-wrap: wrap;
  }
  .primary-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-control);
    color: var(--text-soft);
    font-family: var(--font-head);
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
    transition: color var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  .primary-nav a:hover {
    color: var(--primary);
    background: var(--primary-softer);
  }
  .primary-nav a[aria-current='page'] {
    color: var(--primary);
    box-shadow: inset 0 -2px 0 var(--primary);
    border-radius: var(--radius-control) var(--radius-control) 0 0;
  }
  .primary-nav-more {
    position: relative;
  }
  .primary-nav-more details {
    position: relative;
  }
  .primary-nav-more summary {
    min-height: 46px;
    padding: 0 var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: var(--radius-control);
    color: var(--text-soft);
    font-family: var(--font-head);
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  .primary-nav-more summary::-webkit-details-marker {
    display: none;
  }
  .primary-nav-more summary:hover,
  .primary-nav-more summary.active,
  .primary-nav-more details[open] summary {
    color: var(--primary);
    background: var(--primary-softer);
  }
  .primary-nav-more summary > svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform var(--dur-fast) ease;
  }
  .primary-nav-more details[open] summary > svg {
    transform: rotate(180deg);
  }
  .primary-nav .more-menu {
    position: absolute;
    top: calc(100% + 7px);
    right: 0;
    z-index: 70;
    width: max-content;
    min-width: 220px;
    max-width: 300px;
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 7px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-elevated);
  }
  .primary-nav .more-menu::before {
    content: '';
    position: absolute;
    right: 20px;
    bottom: 100%;
    border: 6px solid transparent;
    border-bottom-color: var(--border);
  }
  .primary-nav .more-menu a {
    width: 100%;
    min-height: 40px;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0 var(--space-3);
  }
  .primary-nav .more-menu a[aria-current='page'] {
    border-radius: var(--radius-control);
    box-shadow: none;
    background: var(--primary-softer);
  }
  .primary-nav .more-menu a svg {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    opacity: 0;
    transition: opacity var(--dur-fast) ease, transform var(--dur-fast) ease;
  }
  .primary-nav .more-menu a:hover svg {
    opacity: 1;
    transform: translate(1px, -1px);
  }
  .primary-nav-search {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-muted);
    font-size: 0.86rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .primary-nav-search:hover {
    color: var(--primary);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: var(--surface-container);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    height: 2px;
    width: 20px;
    margin-inline: auto;
    background: var(--text);
    border-radius: 2px;
    transition: transform var(--dur-normal) ease, opacity var(--dur-normal) ease;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ===== Mobile sidebar drawer ===== */
  /* [hidden] bị display:flex/grid ghi đè → ép ẩn trong phạm vi drawer */
  .mobile-drawer [hidden] {
    display: none !important;
  }
  /* Lớp bọc cố định + cắt tràn: panel nằm ngoài màn hình khi đóng nên không
     được phép tính vào chiều rộng cuộn của tài liệu.
     Vì lớp này phủ kín màn hình nên nó KHÔNG được nhận sự kiện chuột — chỉ
     backdrop (khi mở) và chính panel mới bật lại pointer-events. Tuyệt đối
     không dùng rule gộp kiểu `.drawer-layer > *`: Astro thêm data-astro-cid vào
     cả hai vế nên nó có specificity cao hơn rule của .drawer-backdrop, ghi đè
     `pointer-events: none` và khiến backdrop trong suốt nuốt hết click toàn
     site. */
  .drawer-layer {
    position: fixed;
    inset: 0;
    z-index: 55;
    overflow: hidden;
    pointer-events: none;
  }
  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-panel) ease;
  }
  .drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-drawer {
    position: absolute;
    top: 0;
    right: 0;
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    width: min(86vw, 340px);
    height: 100%;
    background:
      var(--surface)
      url('/assets/mobile-sidebar-tech-bg.webp')
      center bottom / 100% auto no-repeat;
    box-shadow: -12px 0 40px rgba(15, 23, 42, 0.18);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform var(--dur-panel) var(--ease),
      visibility 0s linear var(--dur-panel);
    overflow-y: auto;
  }
  .mobile-drawer.open {
    transform: translateX(0);
    visibility: visible;
    transition: transform var(--dur-panel) var(--ease), visibility 0s;
  }
  .drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  .drawer-title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text);
  }
  .drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    background: var(--surface-container);
    color: var(--text);
    cursor: pointer;
  }
  .drawer-close:hover {
    background: var(--surface-low);
  }
  /* Tài khoản (đầu sidebar) */
  .drawer-account {
    padding: var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  .account-guest {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }
  .account-guest a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: var(--radius-control);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .btn-outline {
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
  }
  .btn-solid {
    background: var(--primary);
    color: var(--primary-contrast);
  }
  .account-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface-low);
    color: var(--text);
  }
  .account-avatar {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-pill);
    background: var(--primary);
    color: var(--primary-contrast);
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
  }
  .account-info {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .account-info strong {
    font-size: 0.92rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .account-info small {
    color: var(--nh-muted);
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .account-chevron {
    flex: 0 0 auto;
    color: var(--nh-muted);
  }
  .drawer-content {
    flex: 1 1 auto;
    padding: var(--space-4);
    overflow-y: auto;
  }
  .drawer-search-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 46px;
    gap: var(--space-2);
    align-items: center;
  }
  .drawer-search {
    min-width: 0;
  }
  .drawer-search :global(.search-box) {
    width: 100%;
  }
  .drawer-category-toggle {
    width: 46px;
    height: 46px;
    display: inline-grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    background: var(--surface-container);
    color: var(--text);
    cursor: pointer;
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      background var(--dur-fast) ease;
  }
  .drawer-category-toggle svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  .drawer-category-toggle:hover,
  .drawer-category-toggle[aria-expanded='true'] {
    border-color: var(--primary);
    background: var(--primary-soft);
    color: var(--primary);
  }
  .drawer-categories {
    margin-top: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface-low);
  }
  .drawer-categories[hidden] {
    display: none;
  }
  .drawer-section-title {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--text-muted);
    font-family: var(--font-head);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .drawer-categories ul,
  .drawer-info-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .drawer-categories a,
  .drawer-info-nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    color: var(--text);
    font-family: var(--font-head);
    font-weight: 600;
    border-radius: var(--radius-control);
  }
  .drawer-categories a:hover,
  .drawer-info-nav a:hover {
    background: var(--surface-container);
    color: var(--primary);
  }
  .drawer-info-nav {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  /* Đăng xuất (cuối sidebar) */
  .drawer-footer {
    padding: var(--space-3) var(--space-4) calc(var(--space-3) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
  }
  .btn-logout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    min-height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--error);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .btn-logout:hover {
    background: var(--error-bg);
    border-color: #fca5a5;
  }

  @media (min-width: 1081px) {
    .primary-nav {
      display: block;
    }
  }
  @media (max-width: 1080px) {
    .auth-actions {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  // ---- Mở/đóng sidebar ----
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const drawer = document.querySelector<HTMLElement>('#mobile-nav');
  const backdrop = document.querySelector<HTMLElement>('[data-backdrop]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-drawer-close]');
  const categoryToggle = document.querySelector<HTMLButtonElement>('[data-category-toggle]');
  const categoryPanel = document.querySelector<HTMLElement>('#drawer-categories');

  function setCategories(open: boolean) {
    if (!categoryToggle || !categoryPanel) return;
    categoryToggle.setAttribute('aria-expanded', String(open));
    categoryToggle.setAttribute('aria-label', open ? 'Đóng danh mục' : 'Mở danh mục');
    categoryPanel.hidden = !open;
  }

  // Phần tử đã focus trước khi mở drawer, để trả focus về đúng chỗ khi đóng.
  let lastFocused: HTMLElement | null = null;

  const FOCUSABLE =
    'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  function focusableInDrawer(): HTMLElement[] {
    if (!drawer) return [];
    return Array.from(drawer.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
      (el) => !el.hasAttribute('hidden') && el.offsetParent !== null,
    );
  }

  function setDrawer(open: boolean) {
    if (!drawer || !toggle) return;
    const wasOpen = drawer.classList.contains('open');
    if (open === wasOpen) return;

    if (open) lastFocused = document.activeElement as HTMLElement | null;

    drawer.classList.toggle('open', open);
    drawer.setAttribute('aria-hidden', String(!open));
    if (open) drawer.removeAttribute('inert');
    else drawer.setAttribute('inert', '');
    backdrop?.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
    document.body.style.overflow = open ? 'hidden' : '';

    if (open) {
      closeBtn?.focus();
    } else {
      setCategories(false);
      // `inert` đã gỡ focus khỏi drawer, đưa nó về nút vừa mở.
      const restoreTo =
        lastFocused && lastFocused !== document.body ? lastFocused : toggle;
      restoreTo.focus();
      lastFocused = null;
    }
  }

  toggle?.addEventListener('click', () =>
    setDrawer(!drawer?.classList.contains('open')),
  );
  closeBtn?.addEventListener('click', () => setDrawer(false));
  backdrop?.addEventListener('click', () => setDrawer(false));
  categoryToggle?.addEventListener('click', () => {
    setCategories(categoryToggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (!drawer?.classList.contains('open')) return;

    if (event.key === 'Escape') {
      setDrawer(false);
      return;
    }

    // Giữ focus bên trong drawer khi nó đang mở.
    if (event.key === 'Tab') {
      const items = focusableInDrawer();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (event.shiftKey && (active === first || !drawer.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  // ---- Trạng thái đăng nhập: nút header + tài khoản/đăng xuất trong sidebar ----
  const categoryMore = document.querySelector<HTMLDetailsElement>('[data-category-more]');
  document.addEventListener('click', (event) => {
    if (categoryMore?.open && !categoryMore.contains(event.target as Node)) {
      categoryMore.open = false;
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && categoryMore?.open) {
      categoryMore.open = false;
      categoryMore.querySelector<HTMLElement>('summary')?.focus();
    }
  });

  const loginLink = document.querySelector<HTMLAnchorElement>('[data-auth-login]');
  const signupLink = document.querySelector<HTMLAnchorElement>('[data-auth-signup]');

  const guestBox = document.querySelector<HTMLElement>('[data-auth-guest]');
  const userCard = document.querySelector<HTMLAnchorElement>('[data-auth-user]');
  const userName = document.querySelector<HTMLElement>('[data-user-name]');
  const userEmail = document.querySelector<HTMLElement>('[data-user-email]');
  const userInitial = document.querySelector<HTMLElement>('[data-user-initial]');
  const logoutBtn = document.querySelector<HTMLButtonElement>('[data-drawer-logout]');

  import('../lib/supabaseBrowser').then(async ({ supabaseBrowser, getCurrentUser }) => {
    async function doLogout(event: Event) {
      event.preventDefault();
      await supabaseBrowser.auth.signOut();
      window.location.href = '/login';
    }
    logoutBtn?.addEventListener('click', doLogout);

    const user = await getCurrentUser();
    if (!user) return;

    const isStaff = ['admin', 'editor', 'author', 'moderator'].includes(user.role);
    const accountHref = isStaff ? '/admin/index.html' : '/account';

    // Nút ở header (desktop)
    if (loginLink && signupLink) {
      loginLink.href = accountHref;
      loginLink.textContent = isStaff ? 'Quản trị' : 'Tài khoản';
      signupLink.href = '#logout';
      signupLink.textContent = 'Đăng xuất';
      signupLink.addEventListener('click', doLogout);
    }

    // Thẻ tài khoản + nút đăng xuất trong sidebar
    if (userCard) {
      userCard.href = accountHref;
      userCard.hidden = false;
    }
    if (guestBox) guestBox.hidden = true;
    if (userName) userName.textContent = user.name || 'Tài khoản';
    if (userEmail) userEmail.textContent = user.email || '';
    if (userInitial) userInitial.textContent = (user.name || user.email || 'N').trim().charAt(0);
    if (logoutBtn) logoutBtn.hidden = false;
  });
</script>
