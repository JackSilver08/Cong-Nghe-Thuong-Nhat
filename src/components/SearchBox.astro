---
export interface Props {
  variant?: 'header' | 'page';
  placeholder?: string;
  inputId?: string;
}
const {
  variant = 'page',
  placeholder = 'Tìm bài viết, chủ đề, tag…',
  inputId = `q-${variant}`,
} = Astro.props;
---

<form class={`search-box ${variant}`} action="/search" method="get" role="search">
  <label for={inputId} class="visually-hidden">Tìm kiếm bài viết</label>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <input
    id={inputId}
    type="search"
    name="q"
    placeholder={placeholder}
    autocomplete="off"
  />
</form>

<style>
  .search-box {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    transition: border-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
  }
  .search-box input {
    border: 0;
    background: transparent;
    outline: none;
    font: inherit;
    font-size: 0.95rem;
    width: 100%;
    min-width: 0;
    align-self: stretch;
    color: inherit;
  }
  .search-box input::placeholder {
    color: var(--text-muted);
  }
  /* header variant */
  .search-box.header {
    background: var(--surface-container);
    border: 1px solid transparent;
    color: var(--text);
    width: min(360px, 100%);
  }
  .search-box.header svg {
    color: var(--text-muted);
    flex: 0 0 auto;
  }

  /* page variant */
  .search-box.page {
    min-height: 52px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-left: 3px solid var(--color-brand-primary);
    color: var(--color-text-primary);
    padding-inline: var(--space-4);
  }
  .search-box.page svg {
    color: var(--color-brand-primary);
    flex: 0 0 auto;
  }

  /* Viền focus vẽ trên cả ô thay vì quanh input trong suốt. Đặt sau các biến
     thể để không bị .search-box.header/.page ghi đè border-color. */
  .search-box:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--ring);
  }
  .search-box input:focus-visible {
    outline: none;
  }
</style>
