---
import type { Post } from '../lib/posts';
import { postSlug, formatDate } from '../lib/posts';
import { categoryLabel } from '../lib/categories';

export interface Props {
  post: Post;
  /** Secondary posts shown in the side column of the hero. */
  side?: Post[];
}

const { post, side = [] } = Astro.props;
const { data } = post;
const url = `/article/${postSlug(post)}`;
---

<section class="hero" aria-label="Tin nổi bật">
  <a href={url} class="hero-main">
    <div class="hero-media">
      {data.image && <img src={data.image} alt={data.imageAlt || ''} fetchpriority="high" />}
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <div class="hero-tags">
        <span class="chip chip-solid">{categoryLabel(data.category)}</span>
        <span class="hero-badge">Tin nổi bật</span>
      </div>
      <h1 class="hero-title">{data.title}</h1>
      <p class="hero-excerpt">{data.excerpt}</p>
      <p class="hero-meta">
        {data.author} • <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
        {data.readingTime && <> • {data.readingTime} phút đọc</>}
      </p>
    </div>
  </a>

  {side.length > 0 && (
    <div class="hero-side">
      <h2 class="hero-side-heading">Nổi bật</h2>
      <div class="hero-side-list">
        {side.map((p) => (
          <a href={`/article/${postSlug(p)}`} class="hero-side-item">
            <div class="hero-side-media">
              {p.data.image && <img src={p.data.image} alt={p.data.imageAlt || ''} loading="lazy" />}
            </div>
            <div class="hero-side-body">
              <h3 class="hero-side-title">{p.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-6) 0;
  }
  .hero-main {
    position: relative;
    isolation: isolate;
    display: block;
    border-radius: var(--radius-card);
    overflow: hidden;
    min-height: 480px;
    background: var(--nh-dark);
    border: 0;
    box-shadow: var(--shadow-subtle);
  }
  .hero-media,
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-media {
    overflow: hidden;
    transform-origin: center;
    z-index: 0;
  }
  .hero-media img {
    transition: transform var(--dur-normal) ease;
  }
  .hero-main:hover .hero-media img {
    transform: scale(1.02);
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(12, 17, 30, 0.12) 0%,
      rgba(12, 17, 30, 0.55) 52%,
      rgba(12, 17, 30, 0.9) 100%
    );
  }
  .hero-content {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    padding: var(--space-6);
    color: #fff;
  }
  .hero-tags {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .hero-badge {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #cdcefb;
  }
  .hero-title {
    color: #fff;
    font-size: var(--fs-hero);
    line-height: 1.14;
    margin: 0 0 var(--space-3);
    max-width: 20ch;
    font-weight: 700;
  }
  .hero-excerpt {
    color: rgba(255, 255, 255, 0.92);
    max-width: 62ch;
    margin: 0 0 var(--space-3);
    font-size: 1rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hero-meta {
    color: #d7dee9;
    font-size: var(--fs-meta);
    margin: 0;
  }

  .hero-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-self: start;
    padding-top: 2px;
    min-width: 0;
  }
  .hero-side-heading {
    position: relative;
    color: var(--text);
    font-size: 1.35rem;
    line-height: 1.2;
    margin: 0 0 var(--space-1);
    padding-left: var(--space-3);
    font-weight: 700;
  }
  .hero-side-heading::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.16em;
    bottom: 0.16em;
    width: 4px;
    border-radius: var(--radius-pill);
    background: var(--primary);
  }
  .hero-side-list {
    display: grid;
    gap: var(--space-1);
  }
  .hero-side-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    background: transparent;
    border: 0;
    border-radius: var(--radius-card);
    padding: var(--space-2);
    transition: background var(--dur-fast) ease;
  }
  .hero-side-item:hover {
    background: var(--surface);
  }
  .hero-side-media {
    flex: 0 0 112px;
    height: 76px;
    border-radius: var(--radius-control);
    overflow: hidden;
    background: var(--surface-container);
  }
  .hero-side-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-side-body {
    min-width: 0;
    padding: 0;
  }
  .hero-side-title {
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hero-side-item:hover .hero-side-title {
    color: var(--primary);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-main {
      min-height: 420px;
    }
    .hero-side {
      padding-top: 0;
    }
  }

  /* Mobile: tách ảnh và nội dung thành hai khối chồng nhau. Chữ nằm trên nền
     đặc nên dễ đọc, còn ảnh không bị chữ che kín như bố cục phủ trước đây. */
  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-4) var(--space-2);
      gap: var(--space-5);
    }
    .hero-main {
      min-height: 0;
      background: var(--surface);
      border: 1px solid var(--border);
    }
    .hero-media,
    .hero-media img {
      position: static;
      height: auto;
    }
    .hero-media {
      aspect-ratio: 16 / 9;
      width: 100%;
    }
    .hero-media img {
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }
    .hero-overlay {
      display: none;
    }
    .hero-content {
      position: static;
      padding: var(--space-4);
      color: var(--text);
    }
    .hero-title {
      color: var(--text);
      font-size: clamp(1.85rem, 7.6vw, 2.15rem); /* 30-34px */
      max-width: none;
      margin-bottom: var(--space-2);
    }
    .hero-badge {
      color: var(--primary);
    }
    .hero-excerpt {
      color: var(--text-soft);
      font-size: 0.98rem;
      -webkit-line-clamp: 3;
    }
    .hero-meta {
      color: var(--text-muted);
    }
    .hero-side-media {
      flex-basis: 96px;
      height: 68px;
    }
    .hero-side-title {
      font-size: 0.98rem;
    }
  }

  @media (max-width: 360px) {
    .hero-side-item {
      gap: var(--space-2);
      padding: var(--space-1);
    }
    .hero-side-media {
      flex-basis: 84px;
      height: 60px;
    }
    .hero-side-title {
      font-size: 0.94rem;
      -webkit-line-clamp: 3;
    }
  }
</style>
