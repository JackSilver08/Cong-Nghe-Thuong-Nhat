---
const destination =
  'https://mushroomie.io.vn/?utm_source=congnghethuongnhat&utm_medium=sidebar_banner&utm_campaign=handmade_custom';
---

<aside class="mushroomie-ad" data-mushroomie-ad aria-label="Quảng cáo từ Mushroomie">
  <button class="ad-close" type="button" aria-label="Đóng quảng cáo Mushroomie" data-ad-close>
    <span aria-hidden="true">×</span>
  </button>

  <a href={destination} target="_blank" rel="sponsored noopener">
    <img
      src="/assets/mushroomie-native-banner.webp"
      alt=""
      width="1792"
      height="1024"
      loading="lazy"
    />
    <span class="ad-shade" aria-hidden="true"></span>
    <span class="ad-copy">
      <span class="ad-label">Quảng cáo · Mushroomie</span>
      <strong>Biến chiếc vòng thành câu chuyện của riêng bạn</strong>
      <span class="ad-description">
        Phụ kiện handmade nhỏ xinh, được phối màu và charm theo chính sở thích của bạn.
      </span>
      <span class="ad-cta">Khám phá ngay <span aria-hidden="true">→</span></span>
    </span>
  </a>
</aside>

<style>
  .mushroomie-ad {
    position: relative;
    margin: 0 0 24px;
  }
  .mushroomie-ad a {
    position: relative;
    display: block;
    min-height: 350px;
    overflow: hidden;
    color: #33253b;
    text-decoration: none;
    border: 1px solid #eadde8;
    border-radius: 16px;
    box-shadow: 0 14px 36px rgba(104, 72, 111, 0.13);
    isolation: isolate;
  }
  .ad-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    display: grid;
    width: 30px;
    height: 30px;
    padding: 0;
    place-items: center;
    color: #4d3a52;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(116, 81, 120, 0.2);
    border-radius: 50%;
    box-shadow: 0 3px 12px rgba(61, 43, 67, 0.13);
    cursor: pointer;
    font-family: Arial, sans-serif;
    font-size: 1.35rem;
    line-height: 1;
    transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }
  .ad-close:hover {
    color: #fff;
    background: #745178;
    transform: scale(1.06);
  }
  .ad-close:focus-visible {
    outline: 3px solid #8d6592;
    outline-offset: 2px;
  }
  .mushroomie-ad img,
  .ad-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mushroomie-ad img {
    object-fit: cover;
    object-position: 68% center;
    transition: transform 0.45s ease;
    z-index: -2;
  }
  .ad-shade {
    background: linear-gradient(0deg, rgba(255, 250, 246, 0.99) 0%, rgba(255, 250, 246, 0.96) 56%, rgba(255, 250, 246, 0.04) 84%);
    z-index: -1;
  }
  .ad-copy {
    display: flex;
    width: 100%;
    min-height: 350px;
    padding: 150px 20px 22px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
  }
  .ad-label {
    margin-bottom: 8px;
    color: #765d78;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ad-copy strong {
    max-width: 260px;
    color: #3d2b43;
    font-family: var(--font-head);
    font-size: 1.15rem;
    line-height: 1.28;
  }
  .ad-description {
    max-width: 270px;
    margin-top: 8px;
    color: #66556a;
    font-size: 0.8rem;
    line-height: 1.48;
  }
  .ad-cta {
    display: inline-flex;
    gap: 8px;
    margin-top: 14px;
    padding: 8px 14px;
    color: #fff;
    background: #745178;
    border-radius: 999px;
    font-family: var(--font-head);
    font-size: 0.78rem;
    font-weight: 700;
    box-shadow: 0 6px 16px rgba(116, 81, 120, 0.22);
  }
  .mushroomie-ad a:hover img {
    transform: scale(1.025);
  }
  .mushroomie-ad a:hover .ad-cta {
    background: #5f4064;
  }
  .mushroomie-ad a:focus-visible {
    outline: 3px solid #8d6592;
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .mushroomie-ad img,
    .ad-close {
      transition: none;
    }
  }
</style>

<script>
  const storageKey = 'mushroomie-ad-dismissed';
  const ad = document.querySelector<HTMLElement>('[data-mushroomie-ad]');
  const closeButton = ad?.querySelector<HTMLButtonElement>('[data-ad-close]');

  try {
    if (sessionStorage.getItem(storageKey) === 'true') ad?.remove();
  } catch {
    // Vẫn hiển thị quảng cáo nếu trình duyệt chặn sessionStorage.
  }

  closeButton?.addEventListener('click', () => {
    ad?.remove();
    try {
      sessionStorage.setItem(storageKey, 'true');
    } catch {
      // Nút đóng vẫn hoạt động dù không lưu được trạng thái.
    }
  });
</script>
