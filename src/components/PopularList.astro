---
import type { Post } from '../lib/posts';
import { postSlug, formatDate } from '../lib/posts';
import { categoryLabelFrom, getCategories } from '../lib/categories';

export interface Props {
  posts: Post[];
  title?: string;
}
const { posts, title = 'Đọc nhiều' } = Astro.props;
const categories = await getCategories();
---

<section class="popular" aria-label={title}>
  <h2 class="popular-title">{title}</h2>
  <ol class="popular-list">
    {posts.map((p, i) => (
      <li class="popular-item">
        <span class="popular-rank">{i + 1}</span>
        <div class="popular-body">
          <a href={`/article/${postSlug(p)}`} class="popular-link">{p.data.title}</a>
          <p class="popular-meta">
            <span class="popular-cat">{categoryLabelFrom(categories, p.data.category)}</span>
            <span aria-hidden="true">•</span>
            <time datetime={p.data.publishedAt.toISOString()}>{formatDate(p.data.publishedAt)}</time>
          </p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .popular {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    box-shadow: var(--shadow-subtle);
  }
  .popular-title {
    font-size: 1.05rem;
    margin: 0 0 var(--space-4);
    padding-left: var(--space-3);
    position: relative;
  }
  .popular-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.14em;
    bottom: 0.14em;
    width: 4px;
    border-radius: var(--radius-pill);
    background: var(--primary);
  }
  .popular-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .popular-item {
    display: flex;
    gap: var(--space-3);
    min-width: 0;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .popular-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .popular-rank {
    flex: 0 0 auto;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.3;
    width: 1.6ch;
    color: var(--primary);
  }
  .popular-body {
    min-width: 0;
  }
  .popular-link {
    display: -webkit-box;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.4;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
  }
  .popular-link:hover {
    color: var(--primary);
  }
  .popular-meta {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-meta);
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
  }
  .popular-cat {
    color: var(--primary);
    font-weight: 600;
  }
</style>
