---
import type { Post } from '../lib/posts';
import { postSlug } from '../lib/posts';
import { categoryLabelFrom, getCategories } from '../lib/categories';
import { readingLabel, relativeTime, signalStrength } from '../lib/signal';

export interface Props {
  posts: Post[];
  title?: string;
}
const { posts, title = 'Đọc nhiều' } = Astro.props;
const categories = await getCategories();
const maxScore = posts.reduce((max, p) => Math.max(max, p.data.popularScore), 0);
---

<section class="rank" aria-labelledby="rank-title">
  <div class="rank-head">
    <span class="rank-code mono">Bảng xếp hạng tín hiệu</span>
    <h2 class="rank-title" id="rank-title">{title}</h2>
  </div>

  <ol class="rank-list">
    {posts.map((p, i) => {
      const strength = signalStrength(p.data.popularScore, maxScore);
      return (
        <li class="rank-item">
          <span class="rank-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="rank-body">
            <h3 class="rank-headline">
              <a href={`/article/${postSlug(p)}`}>{p.data.title}</a>
            </h3>
            <p class="rank-meta mono">
              <span class="rank-cat">{categoryLabelFrom(categories, p.data.category)}</span>
              <span>{readingLabel(p.data.readingTime)}</span>
              <span><time datetime={p.data.publishedAt.toISOString()}>{relativeTime(p.data.publishedAt)}</time></span>
            </p>
            <span class="signal-bar" style={`--strength:${strength}%`} aria-hidden="true"><i></i></span>
          </div>
        </li>
      );
    })}
  </ol>
</section>

<style>
  /* Bảng xếp hạng: số thứ tự cỡ lớn làm điểm nhấn thị giác, mỗi dòng có thanh
     cường độ quy từ điểm phổ biến thật của bài. Không dùng khung thẻ bo góc để
     khối này không giống sidebar tin tức thông thường. */
  .rank {
    position: relative;
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-text-primary);
  }
  .rank-head {
    margin-bottom: var(--space-4);
  }
  .rank-code {
    display: block;
    margin-bottom: 6px;
    color: var(--color-brand-primary);
    font-weight: 700;
  }
  .rank-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .rank-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: rank;
  }
  .rank-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
  }
  .rank-index {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-fast) ease;
  }
  /* Ba vị trí đầu được đánh dấu bằng màu thương hiệu; thứ hạng vẫn đọc được
     bằng chính con số nên thông tin không phụ thuộc vào màu. */
  .rank-item:nth-child(-n + 3) .rank-index {
    color: var(--color-brand-primary);
  }
  .rank-item:hover .rank-index {
    color: var(--color-accent);
  }
  .rank-body {
    flex: 1 1 auto;
    min-width: 0;
  }
  .rank-headline {
    margin: 0 0 6px;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.34;
    letter-spacing: -0.012em;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
  }
  .rank-headline a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .rank-item:hover .rank-headline {
    color: var(--color-brand-primary);
  }
  .rank-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
  }
  .rank-meta > * + *::before {
    content: '+';
    margin-right: var(--space-2);
    color: var(--color-border-strong);
  }
  .rank-cat {
    color: var(--color-brand-primary);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .rank {
      padding: var(--space-4);
    }
    .rank-index {
      font-size: 1.3rem;
    }
  }
</style>
