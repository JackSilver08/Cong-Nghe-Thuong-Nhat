---
import type { Post } from '../lib/posts';
import { postSlug } from '../lib/posts';

export interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

{posts.length > 0 && (
  <div class="ticker" role="region" aria-label="Tin nóng mới nhất">
    <span class="ticker-label">
      <span class="signal-dot" aria-hidden="true"></span>
      Tín hiệu nóng
    </span>
    <div class="ticker-viewport">
      <ul class="ticker-track">
        {posts.map((p) => (
          <li><a href={`/article/${postSlug(p)}`}>{p.data.title}</a></li>
        ))}
        {/* duplicate for seamless loop */}
        {posts.map((p) => (
          <li aria-hidden="true"><a href={`/article/${postSlug(p)}`} tabindex="-1">{p.data.title}</a></li>
        ))}
      </ul>
    </div>
  </div>
)}

<style>
  .ticker {
    display: flex;
    align-items: stretch;
    gap: 0;
    background: var(--color-surface-dark);
    overflow: hidden;
    border: 0;
    box-shadow: none;
    min-height: 46px;
    /* Vát góc dưới trái — cùng motif hình học với hero, thẻ bài và trạm AI. */
    clip-path: polygon(0 0, 100% 0, 100% 100%, 20px 100%, 0 calc(100% - 20px));
  }
  .ticker-label {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-4);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--fs-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--primary-contrast);
    background: var(--color-brand-primary);
  }
  .ticker-label .signal-dot {
    background: #fff;
  }
  .ticker-viewport {
    flex: 1 1 auto;
    overflow: hidden;
    position: relative;
    min-width: 0;
  }
  .ticker-track {
    list-style: none;
    display: flex;
    width: max-content;
    min-width: max-content;
    gap: var(--space-7);
    margin: 0;
    padding: 0;
    white-space: nowrap;
    animation: ticker-scroll 34s linear infinite;
    transform: translate3d(0, 0, 0);
  }
  .ticker-track::-webkit-scrollbar,
  .ticker-viewport::-webkit-scrollbar {
    display: none;
  }
  /* Dừng khi rê chuột hoặc khi một liên kết trong ticker nhận focus bàn phím,
     để người dùng kịp đọc và bấm. */
  .ticker-viewport:hover .ticker-track,
  .ticker-viewport:focus-within .ticker-track {
    animation-play-state: paused;
  }
  .ticker-track li {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }
  .ticker-track a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-on-dark);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .ticker-track a::before {
    content: '';
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    margin-right: var(--space-3);
    background: var(--color-accent-bright);
    rotate: 45deg;
  }
  .ticker-track a:hover {
    color: var(--color-accent-bright);
  }
  @keyframes ticker-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Tôn trọng prefers-reduced-motion: bỏ chạy chữ, đổi thành vùng cuộn tay. */
  @media (prefers-reduced-motion: reduce) {
    .ticker-viewport {
      overflow-x: auto;
    }
    .ticker-track {
      animation: none;
    }
    /* Bản sao chỉ phục vụ vòng lặp mượt, không cần khi đã tắt hiệu ứng. */
    .ticker-track li[aria-hidden='true'] {
      display: none;
    }
  }
</style>
