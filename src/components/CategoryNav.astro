---
import { getCategories } from '../lib/categories';

export interface Props {
  /** Currently active category slug, if any. */
  active?: string;
  /** Include an "All" pill linking to the homepage. */
  showAll?: boolean;
}
const { active, showAll = true } = Astro.props;
const categories = await getCategories();
---

<nav class="cat-nav" aria-label="Lọc theo chuyên mục">
  <ul>
    {showAll && (
      <li>
        <a href="/" class={!active ? 'active' : ''} aria-current={!active ? 'page' : undefined}>
          Tất cả
        </a>
      </li>
    )}
    {categories.map((cat) => (
      <li>
        <a
          href={`/category/${cat.slug}`}
          class={active === cat.slug ? 'active' : ''}
          aria-current={active === cat.slug ? 'page' : undefined}
        >
          {cat.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* Dải chip cuộn ngang có chủ đích: vùng cuộn nằm gọn trong nav, không đẩy
     tràn trang. */
  .cat-nav {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* mờ dần ở mép phải để gợi ý còn nội dung phía sau */
    mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent 100%);
  }
  .cat-nav::-webkit-scrollbar {
    display: none;
  }
  .cat-nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 2px 24px 2px 0;
    white-space: nowrap;
  }
  .cat-nav li {
    flex: 0 0 auto;
  }
  .cat-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-soft);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.88rem;
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease,
      background var(--dur-fast) ease;
  }
  .cat-nav a:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .cat-nav a.active {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--primary-contrast);
  }
  /* Chỉ hiện viền focus trọn vẹn khi chip nằm trong vùng cuộn. */
  .cat-nav a:focus-visible {
    outline-offset: -2px;
  }
</style>
