---
import type { Post } from '../lib/posts';
import { postSlug, formatDate } from '../lib/posts';
import { categoryLabelFrom, getCategories } from '../lib/categories';
import { readingLabel, signalCode, signalStrength } from '../lib/signal';

export interface Props {
  post: Post;
  /** Heading level for the card title (semantics). Default h3. */
  headingLevel?: 2 | 3;
  /** Compact horizontal layout (used in lists). */
  horizontal?: boolean;
  /**
   * Biến thể trình bày. Tất cả dùng chung một bộ dữ liệu bài viết, chỉ khác
   * cách bố trí — `standard` là mặc định nên mọi nơi đang gọi component này
   * vẫn hiển thị như cũ.
   */
  variant?: 'standard' | 'feature' | 'compact' | 'text' | 'data';
  /** Điểm phổ biến cao nhất đang hiển thị, cần cho biến thể `data`. */
  maxScore?: number;
}

const {
  post,
  headingLevel = 3,
  horizontal = false,
  variant = 'standard',
  maxScore,
} = Astro.props;
const { data } = post;
const slug = postSlug(post);
const url = `/article/${slug}`;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const categories = await getCategories();
const categoryName = categoryLabelFrom(categories, data.category);
const code = signalCode(data.category, slug);
const strength = signalStrength(data.popularScore, maxScore ?? data.popularScore);

const hasMedia = variant !== 'text' && variant !== 'data';
const hasExcerpt = !horizontal && (variant === 'standard' || variant === 'feature' || variant === 'text');
---

<article class:list={['card', `card-${variant}`, { 'card-horizontal': horizontal }]}>
  {hasMedia && (
    <a href={url} class="card-media" aria-hidden="true" tabindex="-1">
      {data.image ? (
        <img src={data.image} alt={data.imageAlt || ''} loading="lazy" decoding="async" data-card-image />
      ) : (
        <span class="card-media-fallback">{categoryName}</span>
      )}
      {data.image && (
        <span class="card-media-fallback" data-card-image-fallback hidden>
          {categoryName}
        </span>
      )}
    </a>
  )}

  <div class="card-body">
    <div class="card-meta-top">
      <a href={`/category/${data.category}`} class="chip">{categoryName}</a>
      <span class="signal-code">{code}</span>
      {data.trending && <span class="dot-trend">Xu hướng</span>}
    </div>

    <Heading class="card-title">
      <a href={url}>{data.title}</a>
    </Heading>

    {hasExcerpt && <p class="card-excerpt">{data.excerpt}</p>}

    {variant === 'data' && (
      <p class="card-strength">
        <span class="card-strength-label mono">Cường độ {strength}%</span>
        <span class="signal-bar" style={`--strength:${strength}%`} aria-hidden="true"><i></i></span>
      </p>
    )}

    <p class="card-meta mono">
      <span>{data.author}</span>
      <span><time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time></span>
      <span>{readingLabel(data.readingTime)}</span>
    </p>
  </div>
</article>

<style>
  /* ============================================================
     HỆ THẺ BÀI VIẾT
     Năm biến thể dùng chung một cấu trúc DOM: khác nhau ở cỡ chữ, tỉ lệ ảnh và
     việc hiện/ẩn tóm tắt. Không thẻ nào bo tròn — góc dưới trái của ảnh được
     vát, lặp lại đúng motif của bảng tín hiệu.
     ============================================================ */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }
  .card-media {
    display: block;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-4);
    overflow: hidden;
    background: var(--surface-container);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 24px 100%, 0 calc(100% - 24px));
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-normal) var(--ease);
  }
  .card:hover .card-media img {
    transform: scale(1.04);
  }
  .card-media-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-3);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-text-muted);
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-unit) var(--grid-unit);
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
  }
  .card-meta-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    position: relative;
    z-index: 2;
  }
  .card-meta-top .chip {
    border-radius: 0;
  }
  .dot-trend {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 700;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-signal-warning);
  }
  .card-title {
    font-size: var(--fs-card-title);
    line-height: 1.28;
    letter-spacing: -0.018em;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
  }
  /* Mở rộng vùng chạm của tiêu đề ra toàn thẻ: chữ trong tiêu đề là inline nên
     chỉ bấm trúng đúng nét chữ, khe giữa hai dòng thì trượt. Lớp phủ này trỏ
     đúng URL cũ, không thêm hành vi mới. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card-title a:hover {
    color: var(--color-brand-primary);
  }
  .card-excerpt {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.62;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    position: relative;
    z-index: 2;
    margin: auto 0 0;
    padding-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    color: var(--color-text-muted);
  }
  .card-meta > * + *::before {
    content: '+';
    margin-right: var(--space-2);
    color: var(--color-border-strong);
  }
  .card-strength {
    display: grid;
    gap: 5px;
    margin: var(--space-1) 0 0;
  }
  .card-strength-label {
    color: var(--color-text-secondary);
    font-weight: 700;
  }

  /* ---- feature: bài dẫn dắt của một khu vực ---- */
  .card-feature {
    border-top-color: var(--color-text-primary);
    border-top-width: 2px;
  }
  .card-feature .card-media {
    aspect-ratio: 16 / 10;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 40px 100%, 0 calc(100% - 40px));
  }
  .card-feature .card-title {
    font-size: clamp(1.45rem, 1.1rem + 1.5vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.032em;
    -webkit-line-clamp: 4;
  }
  .card-feature .card-excerpt {
    font-size: 1rem;
    -webkit-line-clamp: 3;
    max-width: 58ch;
  }

  /* ---- compact: ảnh nhỏ bên phải, không tóm tắt ---- */
  .card-compact {
    flex-direction: row-reverse;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .card-compact .card-media {
    flex: 0 0 92px;
    aspect-ratio: 1;
    margin-bottom: 0;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 16px 100%, 0 calc(100% - 16px));
  }
  .card-compact .card-title {
    font-size: 0.99rem;
    -webkit-line-clamp: 3;
  }
  .card-compact .card-meta {
    padding-top: var(--space-2);
  }

  /* ---- text: chỉ chữ, dùng để phá nhịp giữa các ô có ảnh ---- */
  .card-text {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-top-color: var(--color-text-primary);
  }
  .card-text .card-title {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    line-height: 1.2;
    -webkit-line-clamp: 4;
  }
  .card-text .card-excerpt {
    -webkit-line-clamp: 3;
  }

  /* ---- data: đưa chỉ số lên trước, không dùng ảnh ---- */
  .card-data {
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-brand-primary);
  }
  .card-data .card-title {
    font-size: 1.05rem;
    -webkit-line-clamp: 3;
  }

  /* ---- horizontal: giữ nguyên API cũ ---- */
  .card-horizontal {
    flex-direction: row;
    align-items: stretch;
  }
  .card-horizontal .card-media {
    flex: 0 0 110px;
    aspect-ratio: 1 / 1;
    margin-bottom: 0;
    margin-right: var(--space-3);
  }
  .card-horizontal .card-title {
    font-size: 0.98rem;
    -webkit-line-clamp: 2;
  }

  .card-media [hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .card-compact .card-media {
      flex-basis: 80px;
    }
    .card-text {
      padding-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-media img,
    .card:hover .card-media img {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  // Ảnh hỏng (404, hết hạn CDN…) sẽ được thay bằng nhãn chuyên mục thay vì
  // để trống một ô ảnh vỡ.
  document.querySelectorAll<HTMLImageElement>('img[data-card-image]').forEach((img) => {
    const swap = () => {
      const fallback = img.parentElement?.querySelector<HTMLElement>('[data-card-image-fallback]');
      if (!fallback) return;
      img.hidden = true;
      fallback.hidden = false;
    };
    if (img.complete && img.naturalWidth === 0) swap();
    img.addEventListener('error', swap, { once: true });
  });
</script>
