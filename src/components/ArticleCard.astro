---
import type { Post } from '../lib/posts';
import { postSlug, formatDate } from '../lib/posts';
import { categoryLabelFrom, getCategories } from '../lib/categories';

export interface Props {
  post: Post;
  /** Heading level for the card title (semantics). Default h3. */
  headingLevel?: 2 | 3;
  /** Compact horizontal layout (used in lists). */
  horizontal?: boolean;
}

const { post, headingLevel = 3, horizontal = false } = Astro.props;
const { data } = post;
const slug = postSlug(post);
const url = `/article/${slug}`;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const categories = await getCategories();
const categoryName = categoryLabelFrom(categories, data.category);
---

<article class={`card ${horizontal ? 'card-horizontal' : ''}`}>
  <a href={url} class="card-media" aria-hidden="true" tabindex="-1">
    {data.image ? (
      <img src={data.image} alt={data.imageAlt || ''} loading="lazy" data-card-image />
    ) : (
      <span class="card-media-fallback">{categoryName}</span>
    )}
    {data.image && (
      <span class="card-media-fallback" data-card-image-fallback hidden>
        {categoryName}
      </span>
    )}
  </a>
  <div class="card-body">
    <div class="card-meta-top">
      <a href={`/category/${data.category}`} class="chip">{categoryName}</a>
      {data.trending && <span class="dot-trend">Xu hướng</span>}
    </div>
    <Heading class="card-title">
      <a href={url}>{data.title}</a>
    </Heading>
    {!horizontal && <p class="card-excerpt">{data.excerpt}</p>}
    <p class="card-meta">
      <span>{data.author}</span>
      <span aria-hidden="true">•</span>
      <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
      {data.readingTime && (
        <>
          <span aria-hidden="true">•</span>
          <span>{data.readingTime} phút đọc</span>
        </>
      )}
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-width: 0;
    box-shadow: var(--shadow-subtle);
    transition: box-shadow var(--dur-fast) ease, border-color var(--dur-fast) ease;
    height: 100%;
  }
  .card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-elevated);
  }
  .card-media {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--surface-container);
    overflow: hidden;
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-media-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-3);
    text-align: center;
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .card-body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
  }
  .card-meta-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .dot-trend {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--warning);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .card-title {
    font-size: var(--fs-card-title);
    line-height: 1.38;
    margin: 0;
    /* clamp to keep text inside the card */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
  }
  .card-title a:hover {
    color: var(--primary);
  }
  /* Mở rộng vùng chạm của tiêu đề ra toàn thẻ: chữ trong tiêu đề là inline nên
     chỉ bấm trúng đúng nét chữ, khe giữa hai dòng thì trượt. Lớp phủ này trỏ
     đúng URL cũ, không thêm hành vi mới. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  /* Chip chuyên mục và phần meta phải nằm trên lớp phủ để vẫn bấm được. */
  .card-meta-top,
  .card-meta {
    position: relative;
    z-index: 2;
  }
  .card-excerpt {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    margin: auto 0 0;
    padding-top: var(--space-1);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
    color: var(--text-muted);
    font-size: var(--fs-meta);
  }

  /* horizontal variant (lists) */
  .card-horizontal {
    flex-direction: row;
    align-items: stretch;
  }
  .card-horizontal .card-media {
    flex: 0 0 110px;
    aspect-ratio: 1 / 1;
  }
  .card-horizontal .card-title {
    font-size: 0.98rem;
    -webkit-line-clamp: 2;
  }
  .card-horizontal .card-body {
    padding: var(--space-3);
  }

  .card-media [hidden] {
    display: none;
  }
</style>

<script>
  // Ảnh hỏng (404, hết hạn CDN…) sẽ được thay bằng nhãn chuyên mục thay vì
  // để trống một ô ảnh vỡ.
  document.querySelectorAll<HTMLImageElement>('img[data-card-image]').forEach((img) => {
    const swap = () => {
      const fallback = img.parentElement?.querySelector<HTMLElement>('[data-card-image-fallback]');
      if (!fallback) return;
      img.hidden = true;
      fallback.hidden = false;
    };
    if (img.complete && img.naturalWidth === 0) swap();
    img.addEventListener('error', swap, { once: true });
  });
</script>
