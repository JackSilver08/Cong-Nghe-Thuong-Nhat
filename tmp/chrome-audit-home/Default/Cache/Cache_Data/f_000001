:root {
  --nh-dark: #131b2e;
  --nh-dark-soft: #2d3133;
  --nh-ink: #0f172a;
  --nh-cyan: #22d3ee;
  --nh-purple: #4648d4;
  --nh-orange: #f59e0b;
  --nh-white: #f8fafc;
  --nh-muted: #7c839b;
  --nh-grad: linear-gradient(135deg, #4648d4 0%, #6063ee 100%);
  --nh-hot-grad: linear-gradient(135deg, #4648d4 0%, #131b2e 100%);

  /* light content surface */
  --bg: #f7f9fb;
  --surface: #ffffff;
  --surface-low: #f2f4f6;
  --surface-container: #eceef0;
  --text: #191c1e;
  --text-soft: #45464d;
  --text-muted: #76777d;
  --border: #e2e8f0;
  --border-strong: #c6c6cd;
  --ring: rgba(70, 72, 212, 0.28);

  --radius: 12px;
  --radius-sm: 8px;
  --shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
  --shadow-hover: 0 10px 30px rgba(15, 23, 42, 0.08);
  --maxw: 1280px;

  --font-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-head: 'Be Vietnam Pro', 'Inter', sans-serif;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
  background: var(--bg);
}

body {
  margin: 0;
  font-family: var(--font-body);
  background: transparent;
  color: var(--text);
  line-height: 1.65;
  font-size: 16px;
  overflow-x: hidden;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

main {
  flex: 1 0 auto;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-head);
  line-height: 1.2;
  margin: 0 0 0.5em;
  color: var(--text);
  font-weight: 700;
  letter-spacing: 0;
}

p {
  margin: 0 0 1em;
}

/* ============ layout helpers ============ */
.container {
  width: 100%;
  max-width: var(--maxw);
  margin-inline: auto;
  padding-inline: 20px;
}

.section {
  padding-block: 44px;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 22px;
}

.section-title {
  font-size: clamp(1.35rem, 2.4vw, 1.8rem);
  margin: 0;
  position: relative;
  padding-left: 14px;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.15em;
  bottom: 0.15em;
  width: 5px;
  border-radius: 4px;
  background: var(--nh-purple);
}

.section-link {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-soft);
  white-space: nowrap;
}
.section-link:hover {
  color: var(--nh-purple);
}

.grid {
  display: grid;
  gap: 24px;
}
.grid-3 {
  grid-template-columns: repeat(3, 1fr);
}
.grid-4 {
  grid-template-columns: repeat(4, 1fr);
}

.layout-main {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 320px;
  gap: 32px;
  align-items: start;
}

/* ============ badges / chips ============ */
.chip {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  max-width: 100%;
  gap: 6px;
  font-family: var(--font-head);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  padding: 5px 11px;
  border-radius: 4px;
  background: rgba(70, 72, 212, 0.1);
  border: 0;
  color: var(--nh-purple);
}

.chip-solid {
  background: var(--nh-grad);
  color: #fff;
  border: 0;
}

.meta {
  color: var(--text-muted);
  font-size: 0.82rem;
}

/* ============ buttons ============ */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-head);
  font-weight: 600;
  font-size: 0.92rem;
  padding: 10px 18px;
  border-radius: 999px;
  border: 1px solid var(--border-strong);
  background: var(--surface);
  color: var(--text);
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
}
.btn:hover {
  box-shadow: var(--shadow);
  transform: translateY(-1px);
}
.btn-primary {
  background: var(--nh-grad);
  color: #fff;
  border: 0;
}

/* ============ focus ============ */
:focus-visible {
  outline: 2px solid var(--nh-purple);
  outline-offset: 2px;
  border-radius: 4px;
}

.visually-hidden {
  position: absolute !important;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* ============ responsive ============ */
@media (max-width: 960px) {
  .layout-main {
    grid-template-columns: 1fr;
  }
  .grid-4 {
    grid-template-columns: repeat(2, 1fr);
  }
  .grid-3 {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 560px) {
  .grid-3,
  .grid-4 {
    grid-template-columns: 1fr;
  }
  .section {
    padding-block: 28px;
  }
}

/* ============ Motion & ambient effects ============ */

/* Nền aurora động: các vệt màu mờ trôi nhẹ phía sau toàn site */
body::before {
  content: '';
  position: fixed;
  inset: -25vmax;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(38vmax 38vmax at 15% 18%, rgba(70, 72, 212, 0.18), transparent 60%),
    radial-gradient(34vmax 34vmax at 85% 12%, rgba(34, 211, 238, 0.18), transparent 60%),
    radial-gradient(42vmax 42vmax at 72% 88%, rgba(139, 92, 246, 0.14), transparent 62%);
  filter: blur(18px);
  animation: aurora-drift 18s ease-in-out infinite alternate;
}
/* Nội dung luôn nằm trên lớp aurora */
body > * {
  position: relative;
  z-index: 1;
}

@keyframes aurora-drift {
  0% {
    transform: translate3d(0, 0, 0) scale(1);
  }
  50% {
    transform: translate3d(4%, 3%, 0) scale(1.08);
  }
  100% {
    transform: translate3d(-3%, -2%, 0) scale(1.04);
  }
}

/* Hover card sang hơn: nâng nổi + đổ bóng tím nhẹ */
.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 42px rgba(70, 72, 212, 0.16);
}

/* Hiện dần khi cuộn (scroll reveal). Chỉ bật khi JS chạy và người dùng
   không yêu cầu giảm chuyển động — nếu không, nội dung hiển thị bình thường. */
@media (prefers-reduced-motion: no-preference) {
  html.js-reveal :where(.hero, .ticker-wrap, .cat-row, .section-head, .card, .brief, .brief-card, .popular, .popular-item, .hero-side-item, [data-reveal]) {
    opacity: 0;
    transform: translateY(34px) scale(0.98);
    transition: opacity 0.85s ease, transform 0.85s cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: opacity, transform;
  }
  html.js-reveal :where(.hero, .ticker-wrap, .cat-row, .section-head, .card, .brief, .brief-card, .popular, .popular-item, .hero-side-item, [data-reveal]).in-view {
    opacity: 1;
    transform: none;
  }
  html.js-reveal .card.in-view:hover {
    transform: translateY(-4px);
  }
  /* Card trong lưới hiện lần lượt (stagger) cho cảm giác cao cấp */
  html.js-reveal .grid > .card:nth-child(2) {
    transition-delay: 0.06s;
  }
  html.js-reveal .grid > .card:nth-child(3) {
    transition-delay: 0.12s;
  }
  html.js-reveal .grid > .card:nth-child(4) {
    transition-delay: 0.18s;
  }
  html.js-reveal .grid > .card:nth-child(5) {
    transition-delay: 0.24s;
  }
  html.js-reveal .grid > .card:nth-child(6) {
    transition-delay: 0.3s;
  }
}

/* Tôn trọng người dùng tắt hiệu ứng chuyển động */
@media (prefers-reduced-motion: reduce) {
  body::before {
    animation: none;
  }
  html {
    scroll-behavior: auto;
  }
}
